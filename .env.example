# ==============================================================================
# Shift Garage — Template Konfigurasi Lingkungan (.env.example)
# Salin file ini menjadi .env dan sesuaikan nilainya dengan konfigurasi lokal Anda.
# ==============================================================================

# Port Web Server Express.js
PORT=3000

# Konfigurasi Koneksi Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=shift_garage

# Konfigurasi Integrasi Google Gemini Generative AI (LLM)
# Dapatkan API Key gratis di Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# WhatsApp Resmi Bengkel (Pak Vinsen)
BENGKEL_WA=6289620012811

