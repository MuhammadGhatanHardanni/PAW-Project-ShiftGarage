<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- FLOATING AI ASSISTANT CHATBOT WIDGET (SHIFT AI)               -->
<!-- Tema Automotive Deep Navy & Radiant Gold                      -->
<!-- ═══════════════════════════════════════════════════════════════ -->

<div id="shiftAiWidgetContainer" class="fixed bottom-5 right-5 z-50 font-sans text-sm selection:bg-gold-400 selection:text-navy-950 pointer-events-none">
  
  <!-- ── 1. Floating Action Button (FAB) Launcher (Sleek & Unobtrusive) ── -->
  <button id="shiftAiToggleBtn" onclick="toggleShiftAiWidget()" type="button"
    class="pointer-events-auto group relative flex items-center gap-2.5 px-3.5 py-2.5 rounded-full bg-navy-900 hover:bg-navy-850 text-white shadow-navy border border-navy-700/80 hover:scale-105 active:scale-95 transition-all duration-200">
    <div class="w-6 h-6 rounded-full bg-gold-400 text-navy-950 flex items-center justify-center font-black text-[11px] shadow-gold-sm">
      <i class="fa-solid fa-wand-magic-sparkles"></i>
    </div>
    <div class="text-left hidden sm:block pr-1">
      <span class="text-xs font-black tracking-tight block leading-tight text-white">Tanya AI</span>
      <span class="text-[9px] text-slate-400 block font-normal">Shift Garage</span>
    </div>
  </button>

  <!-- ── 2. Compact Chat Popup Window (Proporsional & Anti-Overflow) ── -->
  <div id="shiftAiWindow"
    class="pointer-events-auto hidden fixed sm:fixed bottom-0 sm:bottom-5 right-0 sm:right-5 w-full sm:w-[380px] h-[85vh] sm:h-[510px] max-h-[calc(100vh-100px)] bg-white rounded-t-[28px] sm:rounded-[24px] shadow-2xl border border-slate-200/90 flex flex-col overflow-hidden transition-all duration-200 ease-out transform scale-95 opacity-0 z-50">
    
    <!-- Top Header -->
    <div class="h-14 px-4 bg-navy-900 text-white flex items-center justify-between shrink-0 border-b border-navy-800 select-none">
      <div class="flex items-center gap-2.5">
        <div class="relative">
          <div class="w-8 h-8 rounded-xl bg-gold-400 text-navy-950 flex items-center justify-center font-black shadow-gold-sm">
            <i class="fa-solid fa-robot text-xs"></i>
          </div>
          <span class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 bg-emerald-500 border-2 border-navy-900 rounded-full"></span>
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <h3 class="font-black text-xs text-white tracking-tight">Shift AI Assistant</h3>
            <span class="text-[8px] font-mono font-bold px-1.5 py-0.2 rounded bg-gold-400/20 text-gold-300 border border-gold-400/30">Gemini</span>
          </div>
          <p class="text-[10px] text-slate-300 flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Online &bull; Konteks DB Terhubung</span>
          </p>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center gap-1">
        <!-- Reset Chat -->
        <button onclick="resetShiftAiConversation()" title="Reset Percakapan"
          class="w-7 h-7 rounded-lg bg-navy-800 hover:bg-navy-700 text-slate-300 hover:text-white flex items-center justify-center transition text-xs">
          <i class="fa-solid fa-rotate-left"></i>
        </button>
        <!-- Open Dedicated Full Page -->
        <a href="/chat" title="Buka Halaman Penuh"
          class="w-7 h-7 rounded-lg bg-navy-800 hover:bg-navy-700 text-slate-300 hover:text-white flex items-center justify-center transition text-xs">
          <i class="fa-solid fa-up-right-from-square"></i>
        </a>
        <!-- Close Window -->
        <button onclick="toggleShiftAiWidget()" title="Tutup Widget"
          class="w-7 h-7 rounded-lg bg-navy-800 hover:bg-rose-600 text-slate-300 hover:text-white flex items-center justify-center transition text-xs">
          <i class="fa-solid fa-xmark text-sm"></i>
        </button>
      </div>
    </div>

    <!-- Quick Suggestion Pills Bar (Clean, Non-Selectable, Uniform FontAwesome Icons) -->
    <div class="px-3 py-2 bg-slate-50 border-b border-slate-200/80 overflow-x-auto whitespace-nowrap scrollbar-none flex items-center gap-1.5 shrink-0 select-none">
      <span class="text-[9px] font-extrabold uppercase text-slate-400 shrink-0 pr-0.5">Tanya:</span>
      <button onclick="sendQuickPrompt('Layanan servis apa saja yang tersedia di Shift Garage?')"
        class="text-[10px] px-2.5 py-1 rounded-full bg-white border border-slate-200/90 text-slate-700 hover:border-gold-400 hover:text-navy-950 transition shrink-0 font-medium shadow-2xs inline-flex items-center gap-1">
        <i class="fa-solid fa-motorcycle text-navy-900 text-[10px]"></i>
        <span>Katalog Servis</span>
      </button>
      <button onclick="sendQuickPrompt('Berapa tarif dan estimasi waktu untuk Ganti Oli?')"
        class="text-[10px] px-2.5 py-1 rounded-full bg-white border border-slate-200/90 text-slate-700 hover:border-gold-400 hover:text-navy-950 transition shrink-0 font-medium shadow-2xs inline-flex items-center gap-1">
        <i class="fa-solid fa-tag text-gold-500 text-[10px]"></i>
        <span>Tarif Ganti Oli</span>
      </button>
      <button onclick="sendQuickPrompt('Berapa lama estimasi waktu Tune-Up Injeksi Komplit?')"
        class="text-[10px] px-2.5 py-1 rounded-full bg-white border border-slate-200/90 text-slate-700 hover:border-gold-400 hover:text-navy-950 transition shrink-0 font-medium shadow-2xs inline-flex items-center gap-1">
        <i class="fa-solid fa-clock text-sky-500 text-[10px]"></i>
        <span>Durasi Tune-Up</span>
      </button>
      <button onclick="sendQuickPrompt('Motor matic saya getar gredek saat tarikan awal, rekomendasi servis apa?')"
        class="text-[10px] px-2.5 py-1 rounded-full bg-white border border-slate-200/90 text-slate-700 hover:border-gold-400 hover:text-navy-950 transition shrink-0 font-medium shadow-2xs inline-flex items-center gap-1">
        <i class="fa-solid fa-wrench text-amber-500 text-[10px]"></i>
        <span>CVT Gredek</span>
      </button>
    </div>

    <!-- Conversation Messages Body (min-h-0 prevents flexbox overflow!) -->
    <div id="shiftAiMessagesList" class="flex-1 min-h-0 p-3.5 overflow-y-auto space-y-3 bg-slate-50/60 scroll-smooth">
      <!-- Welcome Message from AI -->
      <div class="flex items-start gap-2.5">
        <div class="w-7 h-7 rounded-lg bg-gold-400 text-navy-950 font-black flex items-center justify-center text-[10px] shrink-0 shadow-gold-sm mt-0.5">
          <i class="fa-solid fa-robot"></i>
        </div>
        <div class="max-w-[88%] bg-white p-3 rounded-2xl rounded-tl-xs border border-slate-200 text-slate-800 text-xs shadow-card space-y-1.5 leading-relaxed">
          <p class="font-bold text-slate-900">
            Halo! Saya Shift AI Assistant 👋
          </p>
          <p class="text-slate-600">
            Saya siap membantu Anda mengetahui paket servis motor, biaya mulai dari, estimasi waktu kerja di pit, dan konsultasi keluhan motor Anda.
          </p>
          <div class="pt-1.5 border-t border-slate-100 text-[10px] text-slate-400">
            Ketik pertanyaan Anda di bawah atau klik salah satu rekomendasi cepat di atas!
          </div>
        </div>
      </div>
    </div>

    <!-- Loading Indicator -->
    <div id="shiftAiLoadingIndicator" class="hidden px-3.5 py-1.5 bg-slate-50 border-t border-slate-100 flex items-center gap-2 shrink-0">
      <div class="w-4 h-4 rounded-md bg-gold-100 text-navy-950 flex items-center justify-center text-[9px]">
        <i class="fa-solid fa-spinner fa-spin"></i>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="text-[11px] font-semibold text-slate-600">Shift AI sedang memproses...</span>
        <div class="flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-gold-400 animate-bounce"></span>
          <span class="w-1.5 h-1.5 rounded-full bg-gold-400 animate-bounce" style="animation-delay: 0.15s"></span>
          <span class="w-1.5 h-1.5 rounded-full bg-gold-400 animate-bounce" style="animation-delay: 0.3s"></span>
        </div>
      </div>
    </div>

    <!-- Error Alert Banner -->
    <div id="shiftAiErrorBanner" class="hidden px-3.5 py-1.5 bg-rose-50 border-t border-rose-200 text-rose-700 text-[11px] flex items-center justify-between shrink-0">
      <div class="flex items-center gap-1.5">
        <i class="fa-solid fa-circle-exclamation text-rose-500 text-xs"></i>
        <span id="shiftAiErrorMessage">Gagal mengirim pesan.</span>
      </div>
      <button onclick="hideShiftAiError()" class="text-rose-400 hover:text-rose-700">
        <i class="fa-solid fa-xmark text-xs"></i>
      </button>
    </div>

    <!-- Input Form (Clean & Sleek) -->
    <form id="shiftAiForm" onsubmit="handleShiftAiSubmit(event)" class="p-3 bg-white border-t border-slate-200/90 shrink-0">
      <div class="flex items-center gap-2 bg-slate-100/80 rounded-2xl p-1.5 border border-slate-200 focus-within:border-gold-400 focus-within:bg-white focus-within:ring-2 focus-within:ring-gold-200 transition">
        <textarea id="shiftAiInput" rows="1" maxlength="500"
          placeholder="Tanyakan servis, tarif, keluhan motor..."
          class="flex-1 bg-transparent px-3 py-1.5 text-xs text-slate-800 placeholder-slate-400 resize-none outline-none max-h-16 scrollbar-none"
          oninput="handleShiftAiInputResize(this)"></textarea>

        <button type="submit" id="shiftAiSendBtn"
          class="w-8 h-8 rounded-xl bg-gold-400 hover:bg-gold-300 text-navy-950 font-black flex items-center justify-center shrink-0 shadow-gold-sm transition hover:scale-105 active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed">
          <i class="fa-solid fa-paper-plane text-xs"></i>
        </button>
      </div>

      <div class="flex items-center justify-between pt-2 px-1 text-[10px] text-slate-400 font-mono select-none">
        <span>Tekan Enter untuk kirim</span>
        <span id="shiftAiCharCount">0/500</span>
      </div>
    </form>
  </div>
</div>

<script>
  let shiftAiIsOpen = false;
  let shiftAiIsLoading = false;

  function toggleShiftAiWidget() {
    const modal = document.getElementById('shiftAiWindow');
    const fabBtn = document.getElementById('shiftAiToggleBtn');
    const input = document.getElementById('shiftAiInput');
    shiftAiIsOpen = !shiftAiIsOpen;

    if (shiftAiIsOpen) {
      fabBtn.classList.add('hidden');
      modal.classList.remove('hidden');
      setTimeout(() => {
        modal.classList.remove('scale-95', 'opacity-0');
        modal.classList.add('scale-100', 'opacity-100');
        input.focus();
      }, 10);
    } else {
      modal.classList.remove('scale-100', 'opacity-100');
      modal.classList.add('scale-95', 'opacity-0');
      setTimeout(() => {
        modal.classList.add('hidden');
        fabBtn.classList.remove('hidden');
      }, 180);
    }
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && shiftAiIsOpen) {
      toggleShiftAiWidget();
    }
  });

  function handleShiftAiInputResize(textarea) {
    textarea.style.height = 'auto';
    textarea.style.height = Math.min(textarea.scrollHeight, 64) + 'px';
    const counter = document.getElementById('shiftAiCharCount');
    if (counter) counter.textContent = `${textarea.value.length}/500`;
  }

  document.getElementById('shiftAiInput')?.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      document.getElementById('shiftAiForm').dispatchEvent(new Event('submit', { cancelable: true }));
    }
  });

  function showShiftAiError(msg) {
    const banner = document.getElementById('shiftAiErrorBanner');
    const label = document.getElementById('shiftAiErrorMessage');
    if (banner && label) {
      label.textContent = msg;
      banner.classList.remove('hidden');
    }
  }

  function hideShiftAiError() {
    const banner = document.getElementById('shiftAiErrorBanner');
    if (banner) banner.classList.add('hidden');
  }

  function appendShiftAiMessage(sender, text) {
    const list = document.getElementById('shiftAiMessagesList');
    if (!list) return;

    const row = document.createElement('div');
    row.className = sender === 'user' ? 'flex items-start justify-end gap-2.5' : 'flex items-start gap-2.5';

    if (sender === 'user') {
      row.innerHTML = `
        <div class="max-w-[85%] bg-navy-900 text-white p-2.5 rounded-2xl rounded-tr-xs text-xs shadow-sm leading-relaxed whitespace-pre-wrap">
          ${escapeHtml(text)}
        </div>
        <div class="w-6 h-6 rounded-lg bg-gold-400 text-navy-950 flex items-center justify-center text-[10px] shrink-0 mt-0.5 font-bold">
          <i class="fa-solid fa-user"></i>
        </div>
      `;
    } else {
      const formatted = formatAiMarkdown(text);
      row.innerHTML = `
        <div class="w-6 h-6 rounded-lg bg-gold-400 text-navy-950 flex items-center justify-center text-[10px] shrink-0 shadow-xs mt-0.5 font-black">
          <i class="fa-solid fa-robot"></i>
        </div>
        <div class="max-w-[88%] bg-white p-3 rounded-2xl rounded-tl-xs border border-slate-200 text-slate-800 text-xs shadow-card leading-relaxed space-y-1.5">
          <div class="prose prose-xs text-slate-800">${formatted}</div>
          <div class="pt-1 text-[9px] text-slate-400 font-mono text-right flex items-center justify-end gap-2">
            <span>Shift Garage AI</span>
            <button onclick="navigator.clipboard.writeText('${escapeJsString(text)}')" class="hover:text-gold-600" title="Salin Jawaban">
              <i class="fa-regular fa-copy"></i>
            </button>
          </div>
        </div>
      `;
    }

    list.appendChild(row);
    list.scrollTop = list.scrollHeight;
  }

  function sendQuickPrompt(promptText) {
    if (shiftAiIsLoading) return;
    const input = document.getElementById('shiftAiInput');
    if (input) {
      input.value = promptText;
      handleShiftAiInputResize(input);
      document.getElementById('shiftAiForm').dispatchEvent(new Event('submit', { cancelable: true }));
    }
  }

  async function handleShiftAiSubmit(e) {
    e.preventDefault();
    if (shiftAiIsLoading) return;

    const input = document.getElementById('shiftAiInput');
    const sendBtn = document.getElementById('shiftAiSendBtn');
    const loading = document.getElementById('shiftAiLoadingIndicator');
    const message = input.value.trim();

    hideShiftAiError();

    if (!message) {
      showShiftAiError('Pesan tidak boleh kosong.');
      return;
    }

    if (message.length < 2) {
      showShiftAiError('Pesan minimal 2 karakter.');
      return;
    }

    appendShiftAiMessage('user', message);
    input.value = '';
    handleShiftAiInputResize(input);

    shiftAiIsLoading = true;
    sendBtn.disabled = true;
    loading.classList.remove('hidden');

    try {
      const response = await fetch('/api/chat', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ message }),
      });

      const data = await response.json();

      if (!response.ok) {
        throw new Error(data.pesan || data.error || `HTTP error ${response.status}`);
      }

      if (data.success && data.data && data.data.reply) {
        appendShiftAiMessage('ai', data.data.reply);
      } else {
        throw new Error('Format balasan API tidak valid.');
      }
    } catch (err) {
      console.error('Shift AI request error:', err);
      showShiftAiError(err.message || 'Gagal menghubungi server.');
      appendShiftAiMessage('ai', 'Maaf, terjadi kesalahan saat menghubungi asisten AI: ' + err.message);
    } finally {
      shiftAiIsLoading = false;
      sendBtn.disabled = false;
      loading.classList.add('hidden');
    }
  }

  function resetShiftAiConversation() {
    const list = document.getElementById('shiftAiMessagesList');
    if (!list) return;
    list.innerHTML = `
      <div class="flex items-start gap-2.5">
        <div class="w-7 h-7 rounded-lg bg-gold-400 text-navy-950 font-black flex items-center justify-center text-[10px] shrink-0 shadow-gold-sm mt-0.5">
          <i class="fa-solid fa-robot"></i>
        </div>
        <div class="max-w-[88%] bg-white p-3 rounded-2xl rounded-tl-xs border border-slate-200 text-slate-800 text-xs shadow-card space-y-1.5 leading-relaxed">
          <p class="font-bold text-slate-900">Percakapan Direset 🔄</p>
          <p class="text-slate-600">
            Ada yang bisa saya bantu terkait layanan servis motor, jam operasional, atau estimasi tarif Shift Garage?
          </p>
        </div>
      </div>
    `;
    hideShiftAiError();
  }

  function escapeHtml(str) {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function escapeJsString(str) {
    return str.replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '\\"').replace(/\n/g, '\\n');
  }

  function formatAiMarkdown(text) {
    let clean = escapeHtml(text);
    clean = clean.replace(/\*\*(.*?)\*\*/g, '<strong class="font-extrabold text-slate-900">$1</strong>');
    clean = clean.replace(/^[•\-\*]\s+(.*)$/gm, '<li class="ml-4 list-disc">$1</li>');
    clean = clean.replace(/^(\d+)\.\s+(.*)$/gm, '<li class="ml-4 list-decimal font-medium">$2</li>');
    clean = clean.replace(/`([^`]+)`/g, '<code class="bg-slate-100 text-navy-900 font-mono px-1 py-0.5 rounded text-[11px]">$1</code>');
    clean = clean.replace(/\n\n/g, '<div class="h-1.5"></div>');
    clean = clean.replace(/\n/g, '<br/>');
    return clean;
  }
</script>
