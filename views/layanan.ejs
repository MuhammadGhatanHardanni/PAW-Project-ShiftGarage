<%- include('partials/head', { judul }) %>

  <body
    class="bg-slate-100 text-slate-800 min-h-screen flex flex-col font-sans text-sm selection:bg-gold-400 selection:text-navy-950">

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- TOP APP BAR (WORKSHOP MANAGEMENT SYSTEM — SHIFT GARAGE)        -->
    <!-- Deep Navy & Gold Unified Header                                 -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <header class="sticky top-0 z-40 bg-white border-b border-slate-200/90 shadow-2xs">
      <div class="px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16 sm:h-20">

          <!-- Left: Brand Logo & Status -->
          <div class="flex items-center gap-3">
            <a href="/admin" class="flex items-center gap-2.5 group transition">
              <div
                class="w-10 h-10 rounded-xl bg-gold-400 text-navy-950 flex items-center justify-center font-black text-base shadow-gold-sm group-hover:scale-105 transition">
                <i class="fa-solid fa-motorcycle"></i>
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <span class="text-lg font-black tracking-tight text-navy-900">ShiftGarage<span
                      class="text-gold-500">.com</span></span>
                  <span
                    class="text-[9px] font-black uppercase px-2 py-0.5 rounded-full bg-navy-900 text-gold-400 border border-navy-800">
                    Portal Bengkel
                  </span>
                </div>
              </div>
            </a>

            <div class="h-6 w-px bg-slate-200 hidden sm:block mx-1"></div>

            <!-- Status PostgreSQL Live Badge -->
            <div
              class="hidden sm:inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 text-[11px] font-bold border border-emerald-200">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span class="font-mono">PostgreSQL: Live</span>
            </div>

            <div class="hidden lg:inline-flex items-center gap-1.5 text-xs text-slate-500 font-medium ml-2">
              <span>Mekanik Utama:</span>
              <span class="font-bold text-navy-900">Pak Vinsen</span>
            </div>
          </div>

          <!-- Right Quick Actions -->
          <div class="flex items-center gap-2.5">
            <!-- Tombol + Antrean Walk-in -->
            <button onclick="openWalkinModal()" type="button"
              class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-gold-400 hover:bg-gold-300 text-navy-950 font-black text-xs transition shadow-gold-sm">
              <i class="fa-solid fa-plus text-[10px]"></i>
              <span>+ Antrean Walk-in</span>
            </button>

            <!-- Lihat Website Publik -->
            <a href="/" target="_blank"
              class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-navy-900 font-bold transition text-xs border border-slate-200">
              <span>Web Publik</span>
              <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
            </a>

            <!-- Logout Staf Pak Vinsen -->
            <a href="/admin/logout" title="Keluar dari Portal Admin"
              class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 font-bold transition text-xs border border-rose-200">
              <i class="fa-solid fa-right-from-bracket text-[10px]"></i>
              <span class="hidden sm:inline">Keluar</span>
            </a>
          </div>

        </div>
      </div>
    </header>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- FLASH NOTIFICATION ALERT                                      -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <% if (typeof notif !=='undefined' && notif) { %>
      <div class="px-4 sm:px-6 lg:px-8 pt-3">
        <div
          class="p-3.5 rounded-xl flex items-center justify-between <%= tipeNotif === 'error' ? 'bg-rose-50 border border-rose-200 text-rose-800' : 'bg-emerald-50 border border-emerald-200 text-emerald-800' %> shadow-2xs text-xs font-bold">
          <div class="flex items-center gap-2.5">
            <i
              class="fa-solid <%= tipeNotif === 'error' ? 'fa-triangle-exclamation text-rose-500' : 'fa-circle-check text-emerald-600' %> text-base"></i>
            <span>
              <%= notif %>
            </span>
          </div>
          <a href="/admin" class="underline opacity-75 hover:opacity-100">Tutup</a>
        </div>
      </div>
      <% } else { %>
        <div id="adminGreetingBar" class="px-4 sm:px-6 lg:px-8 pt-3">
          <div
            class="p-3.5 rounded-xl flex items-center justify-between bg-emerald-50 border border-emerald-200 text-emerald-800 shadow-2xs text-xs font-bold">
            <div class="flex items-center gap-2.5">
              <i class="fa-solid fa-circle-check text-emerald-600 text-base"></i>
              <span>Selamat datang kembali, Pak Vinsen!</span>
            </div>
            <button type="button" onclick="document.getElementById('adminGreetingBar').remove()"
              class="text-emerald-700 hover:text-emerald-900 font-semibold cursor-pointer text-xs">Tutup</button>
          </div>
        </div>
        <% } %>

          <!-- ═══════════════════════════════════════════════════════════════ -->
          <!-- MAIN WORKSPACE LAYOUT (SIDEBAR + MAIN CONTENT AREA)           -->
          <!-- ═══════════════════════════════════════════════════════════════ -->
          <div class="flex-1 flex flex-col md:flex-row min-h-0">

            <!-- ── LEFT SIDEBAR (RESPONSIVE: APP TABS DI MOBILE, FULL SIDEBAR DI DESKTOP) ── -->
            <aside
              class="w-full md:w-64 bg-white border-b md:border-b-0 md:border-r border-slate-200/90 shrink-0 flex flex-col justify-between p-3 md:p-4">

              <div class="space-y-3 md:space-y-6">

                <!-- Workshop Info Box (Deep Dark Navy & Gold) -->
                <div
                  class="p-3 md:p-4 rounded-xl md:rounded-2xl bg-navy-900 text-white shadow-navy border border-navy-800">
                  <div class="flex items-center justify-between mb-1">
                    <span class="text-[10px] font-black uppercase tracking-wider text-gold-400">Shift Garage Pro</span>
                    <span
                      class="text-[9px] font-mono px-1.5 py-0.5 rounded bg-navy-800 text-slate-300 border border-navy-700">v1.0</span>
                  </div>
                  <h3 class="font-black text-sm leading-tight text-white">Bengkel Pak Vinsen</h3>
                  <p class="text-[11px] text-slate-400 mt-0.5">Sistem Operasional Terpadu</p>
                </div>

                <!-- Navigation Menu (Horizontal Scrollable on Mobile, Stacked on Desktop) -->
                <nav
                  class="flex md:flex-col gap-1.5 overflow-x-auto md:overflow-x-visible pb-1 md:pb-0 scrollbar-none text-xs font-bold">

                  <!-- Menu 1: Kasir & POS Servis -->
                  <button type="button" onclick="switchAdminTab('pos')" id="sidebarBtn-pos"
                    class="shrink-0 md:shrink w-auto md:w-full flex items-center justify-between gap-2.5 px-3.5 py-2.5 rounded-xl transition <%= activeTab === 'pos' ? 'bg-navy-900 text-gold-400 font-black shadow-sm' : 'text-slate-600 hover:bg-slate-100 hover:text-navy-900' %>">
                    <div class="flex items-center gap-2">
                      <i class="fa-solid fa-cash-register text-sm"></i>
                      <span class="whitespace-nowrap">Kasir &amp; POS</span>
                    </div>
                    <span
                      class="text-[10px] font-mono font-bold px-1.5 py-0.2 rounded bg-navy-800 text-gold-400 hidden sm:inline">POS</span>
                  </button>

                  <!-- Menu 2: Antrean Pit (Kanban Board) -->
                  <button type="button" onclick="switchAdminTab('kanban')" id="sidebarBtn-kanban"
                    class="shrink-0 md:shrink w-auto md:w-full flex items-center justify-between gap-2.5 px-3.5 py-2.5 rounded-xl transition <%= activeTab === 'kanban' ? 'bg-navy-900 text-gold-400 font-black shadow-sm' : 'text-slate-600 hover:bg-slate-100 hover:text-navy-900' %>">
                    <div class="flex items-center gap-2">
                      <i class="fa-solid fa-table-columns text-sm"></i>
                      <span class="whitespace-nowrap">Antrean Pit</span>
                    </div>
                    <span class="text-[10px] font-mono font-bold px-1.5 py-0.2 rounded bg-slate-100 text-slate-700">
                      <%= antrean ? antrean.length : 0 %>
                    </span>
                  </button>

                  <!-- Menu 3: Pesanan Masuk (Booking) -->
                  <% const bookingBaruCount=bookings ? bookings.filter(b=> b.status === 'menunggu_konfirmasi').length :
                    0; %>
                    <button type="button" onclick="switchAdminTab('pesanan')" id="sidebarBtn-pesanan"
                      class="shrink-0 md:shrink w-auto md:w-full flex items-center justify-between gap-2.5 px-3.5 py-2.5 rounded-xl transition <%= activeTab === 'pesanan' ? 'bg-navy-900 text-gold-400 font-black shadow-sm' : 'text-slate-600 hover:bg-slate-100 hover:text-navy-900' %>">
                      <div class="flex items-center gap-2">
                        <i class="fa-solid fa-inbox text-sm"></i>
                        <span class="whitespace-nowrap">Pesanan Masuk</span>
                      </div>
                      <% if (bookingBaruCount> 0) { %>
                        <span
                          class="text-[10px] font-black px-2 py-0.5 rounded-full bg-gold-400 text-navy-950 animate-pulse">
                          <%= bookingBaruCount %> Baru
                        </span>
                        <% } %>
                    </button>

                    <!-- Menu 4: Katalog Layanan (PostgreSQL CRUD) -->
                    <button type="button" onclick="switchAdminTab('katalog')" id="sidebarBtn-katalog"
                      class="shrink-0 md:shrink w-auto md:w-full flex items-center justify-between gap-2.5 px-3.5 py-2.5 rounded-xl transition <%= activeTab === 'katalog' ? 'bg-navy-900 text-gold-400 font-black shadow-sm' : 'text-slate-600 hover:bg-slate-100 hover:text-navy-900' %>">
                      <div class="flex items-center gap-2">
                        <i class="fa-solid fa-database text-sm"></i>
                        <span class="whitespace-nowrap">Katalog CRUD</span>
                      </div>
                      <span class="text-[10px] font-mono font-bold px-1.5 py-0.2 rounded bg-slate-100 text-slate-700">
                        <%= layanan ? layanan.length : 0 %>
                      </span>
                    </button>

                    <!-- Menu 5: Asisten AI Pak Vinsen -->
                    <button type="button" onclick="switchAdminTab('ai-admin')" id="sidebarBtn-ai-admin"
                      class="shrink-0 md:shrink w-auto md:w-full flex items-center justify-between gap-2.5 px-3.5 py-2.5 rounded-xl transition <%= activeTab === 'ai-admin' ? 'bg-navy-900 text-gold-400 font-black shadow-sm' : 'text-slate-600 hover:bg-slate-100 hover:text-navy-900' %>">
                      <div class="flex items-center gap-2">
                        <i class="fa-solid fa-wand-magic-sparkles text-sm text-gold-500"></i>
                        <span class="whitespace-nowrap">Asisten AI</span>
                      </div>
                      <span
                        class="text-[9px] font-mono font-bold px-1.5 py-0.2 rounded bg-gold-100 text-gold-800 border border-gold-300">Gemini</span>
                    </button>

                </nav>
              </div>

              <!-- Bottom System Indicators (Desktop Only) -->
              <div class="hidden md:block pt-4 border-t border-slate-200 text-[11px] text-slate-500 space-y-1.5">
                <div class="flex justify-between items-center">
                  <span>Engine:</span>
                  <span class="font-bold text-navy-900">Express MVC</span>
                </div>
                <div class="flex justify-between items-center">
                  <span>Database:</span>
                  <span class="font-mono font-bold text-emerald-700">PostgreSQL</span>
                </div>
              </div>

            </aside>

            <!-- ── MAIN CONTENT WORKSPACE ── -->
            <main class="flex-1 p-4 sm:p-6 lg:p-8 overflow-y-auto">

              <!-- ═════════════════════════════════════════════════════════════ -->
              <!-- VIEW 1: KASIR & POS SERVIS                                    -->
              <!-- ═════════════════════════════════════════════════════════════ -->
              <div id="view-pos" class="<%= activeTab === 'pos' ? '' : 'hidden' %>">

                <div class="grid grid-cols-1 xl:grid-cols-12 gap-6 items-start">

                  <!-- Left/Middle Section: Data Pelanggan & Daftar Produk (8 Cols) -->
                  <div class="xl:col-span-8 space-y-5">

                    <!-- 1. Card Data Pelanggan -->
                    <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-2xs">
                      <div class="flex items-center justify-between mb-4">
                        <h3 class="font-black text-sm text-navy-900">Data Pelanggan &amp; Motor</h3>
                        <button type="button" onclick="openWalkinModal()"
                          class="text-xs font-bold text-gold-600 hover:text-navy-900 flex items-center gap-1 transition">
                          <i class="fa-solid fa-plus text-[10px]"></i>
                          <span>+ Tambah Pelanggan Baru</span>
                        </button>
                      </div>

                      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <!-- Pelanggan Selector -->
                        <div>
                          <label
                            class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1.5">Pelanggan</label>
                          <select id="posCustomerSelect" onchange="handleCustomerSelect(this)"
                            class="w-full bg-slate-50 px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs text-slate-800 font-semibold focus:outline-none focus:border-navy-900 focus:bg-white transition">
                            <option value="Suhartono Anwar|+62 858 9102 7782|Honda Vario 160|AB 5928 VG">Suhartono Anwar
                              (+62 858 9102 7782)</option>
                            <option value="Budi Santoso|081234567890|Honda Vario 160|AB 4521 XG">Budi Santoso
                              (081234567890)</option>
                            <option value="Siti Rahayu|085712349988|Yamaha NMAX 155|AB 2890 YT">Siti Rahayu
                              (085712349988)</option>
                            <option value="Dimas Saputra|087890123456|Honda Beat FI|AB 3112 QA">Dimas Saputra
                              (087890123456)</option>
                            <option value="Agus Hendrawan|081298765432|Yamaha Aerox 155|AB 1988 PL">Agus Hendrawan
                              (081298765432)</option>
                          </select>
                        </div>

                        <!-- Motor & Plat -->
                        <div>
                          <label
                            class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1.5">Kendaraan
                            &amp; Plat Nomor</label>
                          <div class="flex items-center gap-2">
                            <div
                              class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center text-slate-600 text-xs shrink-0 font-bold">
                              <i class="fa-solid fa-motorcycle"></i>
                            </div>
                            <div
                              class="flex-1 bg-slate-50 px-3 py-2 rounded-xl border border-slate-200 text-xs font-bold text-slate-800"
                              id="posVehicleDisplay">
                              Honda Vario 160 &bull; AB 5928 VG
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>

                    <!-- 2. Card Daftar Produk / Layanan -->
                    <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-2xs">

                      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
                        <h3 class="font-black text-sm text-navy-900">Daftar Layanan &amp; Suku Cadang</h3>

                        <!-- Search Box -->
                        <div class="relative w-full sm:w-64">
                          <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-slate-400 text-xs"></i>
                          <input type="text" id="posProductSearch" oninput="filterPosTable()"
                            placeholder="Cari layanan atau part..."
                            class="w-full pl-8 pr-3 py-1.5 rounded-xl bg-slate-50 border border-slate-200 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:border-navy-900 focus:bg-white transition" />
                        </div>
                      </div>

                      <!-- Category Filter Pills (Deep Navy & Gold Theme) -->
                      <div
                        class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none mb-4 text-xs font-semibold">
                        <button type="button" onclick="filterCategory('Semua', this)"
                          class="cat-pill px-3 py-1 rounded-lg bg-navy-900 text-gold-400 font-black transition shrink-0 shadow-xs">
                          Semua
                        </button>
                        <button type="button" onclick="filterCategory('Perawatan', this)"
                          class="cat-pill px-3 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition shrink-0">
                          Perawatan Rutin
                        </button>
                        <button type="button" onclick="filterCategory('Keselamatan', this)"
                          class="cat-pill px-3 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition shrink-0">
                          Rem &amp; Rantai
                        </button>
                        <button type="button" onclick="filterCategory('Penggantian Suku Cadang', this)"
                          class="cat-pill px-3 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition shrink-0">
                          Suku Cadang &amp; Ban
                        </button>
                        <button type="button" onclick="filterCategory('Perbaikan Besar', this)"
                          class="cat-pill px-3 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition shrink-0">
                          Overhaul Mesin
                        </button>
                        <button type="button" onclick="filterCategory('Diagnosis', this)"
                          class="cat-pill px-3 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition shrink-0">
                          Diagnosis AI
                        </button>
                      </div>

                      <!-- Product Table -->
                      <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs text-slate-700" id="posProductTable">
                          <thead
                            class="bg-slate-50 border-b border-slate-200 text-slate-400 uppercase text-[10px] font-bold">
                            <tr>
                              <th class="py-2.5 px-3 w-10">No</th>
                              <th class="py-2.5 px-3">Nama Layanan / Suku Cadang</th>
                              <th class="py-2.5 px-3">Kategori</th>
                              <th class="py-2.5 px-3 text-right">Harga</th>
                              <th class="py-2.5 px-3 text-center w-14">Aksi</th>
                            </tr>
                          </thead>
                          <tbody class="divide-y divide-slate-100 font-medium">
                            <% if (layanan && layanan.length> 0) { %>
                              <% layanan.forEach(function(item, idx) { %>
                                <tr class="hover:bg-slate-50/80 transition pos-row"
                                  data-name="<%= item.nama.toLowerCase() %>" data-cat="<%= item.kategori %>">
                                  <td class="py-3 px-3 text-slate-400 font-mono">
                                    <%= idx + 1 %>
                                  </td>
                                  <td class="py-3 px-3 font-bold text-slate-900">
                                    <span>
                                      <%= item.nama %>
                                    </span>
                                    <span class="block text-[11px] font-normal text-slate-500 truncate max-w-sm">
                                      <%= item.deskripsi %>
                                    </span>
                                  </td>
                                  <td class="py-3 px-3 text-slate-500">
                                    <span
                                      class="px-2 py-0.5 rounded-md bg-slate-100 text-[10px] font-bold border border-slate-200">
                                      <%= item.kategori %>
                                    </span>
                                  </td>
                                  <td class="py-3 px-3 font-black text-navy-900 font-mono text-right">
                                    <%= formatRupiah(item.hargaMulaiDari || item.harga_mulai_dari) %>
                                  </td>
                                  <td class="py-3 px-3 text-center">
                                    <!-- Add to Order Button (Radiant Gold Accent) -->
                                    <button type="button" data-id="<%= item.id %>" data-nama="<%= item.nama %>"
                                      data-harga="<%= item.hargaMulaiDari || item.harga_mulai_dari %>"
                                      onclick="addToOrder(this)"
                                      class="w-7 h-7 rounded-lg bg-gold-400 hover:bg-gold-300 text-navy-950 font-black flex items-center justify-center mx-auto transition shadow-gold-sm text-xs"
                                      title="Tambah ke Order">
                                      <i class="fa-solid fa-cart-plus"></i>
                                    </button>
                                  </td>
                                </tr>
                                <% }); %>
                                  <% } %>
                          </tbody>
                        </table>
                      </div>

                    </div>

                  </div>

                  <!-- Right Section: Order Detail / Struk Kasir (4 Cols) -->
                  <div class="xl:col-span-4 bg-white rounded-2xl p-5 border border-slate-200 shadow-2xs space-y-4">

                    <div class="flex items-center justify-between pb-3 border-b border-slate-200">
                      <h3 class="font-black text-sm text-navy-900">Order Detail</h3>
                      <div class="flex items-center gap-2">
                        <span class="text-[11px] font-mono text-slate-500 font-bold" id="currentOrderDate">16 Nov
                          2026</span>
                        <button type="button" onclick="clearOrderCart()"
                          class="text-slate-400 hover:text-rose-600 text-xs" title="Kosongkan Cart">
                          <i class="fa-solid fa-rotate-right"></i>
                        </button>
                      </div>
                    </div>

                    <!-- Cart Items List -->
                    <div id="orderItemsContainer" class="space-y-3 min-h-[140px] max-h-[300px] overflow-y-auto pr-1">
                      <!-- Rendered via JS -->
                    </div>

                    <!-- Kilometer Saat Servis -->
                    <div>
                      <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Kilometer
                        Saat Servis</label>
                      <div class="relative">
                        <input type="text" id="posKmInput" value="24580 KM"
                          class="w-full bg-slate-50 px-3 py-2 rounded-xl border border-slate-200 text-xs font-mono font-bold text-slate-800 focus:outline-none focus:border-navy-900 focus:bg-white transition" />
                      </div>
                    </div>

                    <!-- Catatan Mekanik -->
                    <div>
                      <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Catatan
                        Pengerjaan</label>
                      <textarea id="posNotesInput" rows="2" placeholder="Catatan keluhan & suku cadang yang diganti..."
                        class="w-full bg-slate-50 px-3 py-2 rounded-xl border border-slate-200 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:border-navy-900 focus:bg-white transition resize-none">Pembersihan throttle body & injector selesai. Cek kampas rem di servis berikutnya.</textarea>
                    </div>

                    <!-- Total Price Display -->
                    <div class="pt-3 border-t border-slate-200 flex items-baseline justify-between">
                      <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Total Pembayaran</span>
                      <span class="text-2xl font-black text-navy-900 font-mono" id="orderTotalDisplay">Rp 150.000</span>
                    </div>

                    <!-- Bayar Button (Radiant Gold Accent) -->
                    <button type="button" onclick="checkoutPosOrder()"
                      class="w-full py-3.5 rounded-xl bg-gold-400 hover:bg-gold-300 text-navy-950 font-black text-sm transition shadow-gold-sm flex items-center justify-center gap-2 hover:scale-[1.01] active:scale-[0.99]">
                      <i class="fa-solid fa-receipt text-xs"></i>
                      <span>Bayar &amp; Terbitkan Nota WA</span>
                    </button>

                  </div>

                </div>

              </div>

              <!-- ═════════════════════════════════════════════════════════════ -->
              <!-- VIEW 2: KANBAN BOARD ANTREAN PIT                              -->
              <!-- ═════════════════════════════════════════════════════════════ -->
              <div id="view-kanban" class="<%= activeTab === 'kanban' ? '' : 'hidden' %> space-y-6">

                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                  <div>
                    <h2 class="text-lg font-black text-navy-900">Kanban Board Antrean Pit Servis</h2>
                    <p class="text-xs text-slate-500">Pindahkan kartu status pengerjaan motor (Menunggu &rarr;
                      Dikerjakan &rarr; Selesai).</p>
                  </div>

                  <button onclick="openWalkinModal()" type="button"
                    class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-navy-900 hover:bg-navy-850 text-gold-400 font-black text-xs transition self-start shadow-sm">
                    <i class="fa-solid fa-plus text-gold-400"></i>
                    <span>+ Tambah Antrean Walk-in</span>
                  </button>
                </div>

                <!-- 3 Kanban Columns Grid -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-start">

                  <!-- Kolom 1: Menunggu di Pit -->
                  <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-2xs">
                    <div class="flex items-center justify-between pb-3 border-b border-slate-100 mb-3">
                      <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
                        <h4 class="font-extrabold text-xs uppercase text-slate-900 tracking-wider">Menunggu di Pit</h4>
                      </div>
                      <span
                        class="text-xs font-mono font-bold px-2 py-0.5 rounded-full bg-amber-50 text-amber-800 border border-amber-200">
                        <%= antrean ? antrean.filter(a=> a.status === 'menunggu').length : 0 %>
                      </span>
                    </div>

                    <div class="space-y-3">
                      <% const listMenunggu=antrean ? antrean.filter(a=> a.status === 'menunggu') : []; %>
                        <% if (listMenunggu.length> 0) { %>
                          <% listMenunggu.forEach(function(item) { %>
                            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/90 text-xs space-y-2">
                              <div class="flex justify-between items-center text-[10px] text-slate-400 font-mono">
                                <span>
                                  <%= item.id %>
                                </span>
                                <span class="font-bold text-slate-600">
                                  <%= item.pit_nomor || 'Pit 1' %>
                                </span>
                              </div>
                              <div>
                                <h5 class="font-bold text-navy-900">
                                  <%= item.tipe_motor %> (<%= item.no_polisi %>)
                                </h5>
                                <p class="text-slate-600 text-[11px] mt-0.5">
                                  <%= item.layanan_nama %>
                                </p>
                                <p class="text-[10px] text-slate-400 mt-1 italic">Pelanggan: <%= item.nama_pelanggan %>
                                </p>
                              </div>
                              <form action="/admin/antrean/status/<%= item.id %>" method="POST"
                                class="pt-2 border-t border-slate-200/80">
                                <input type="hidden" name="status" value="dikerjakan" />
                                <button type="submit"
                                  class="w-full py-1.5 rounded-lg bg-navy-900 hover:bg-navy-850 text-gold-400 font-black text-[11px] transition flex items-center justify-center gap-1.5 shadow-xs">
                                  <span>Mulai Kerjakan</span>
                                  <i class="fa-solid fa-arrow-right text-[9px]"></i>
                                </button>
                              </form>
                            </div>
                            <% }); %>
                              <% } else { %>
                                <p class="text-xs text-slate-400 text-center py-6">Tidak ada motor antre.</p>
                                <% } %>
                    </div>
                  </div>

                  <!-- Kolom 2: Sedang Dikerjakan -->
                  <div class="bg-white rounded-2xl p-4 border border-blue-200 shadow-2xs">
                    <div class="flex items-center justify-between pb-3 border-b border-blue-100 mb-3">
                      <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-blue-600 animate-pulse"></span>
                        <h4 class="font-extrabold text-xs uppercase text-slate-900 tracking-wider">Sedang Dikerjakan
                        </h4>
                      </div>
                      <span
                        class="text-xs font-mono font-bold px-2 py-0.5 rounded-full bg-blue-50 text-blue-800 border border-blue-200">
                        <%= antrean ? antrean.filter(a=> a.status === 'dikerjakan').length : 0 %>
                      </span>
                    </div>

                    <div class="space-y-3">
                      <% const listDikerjakan=antrean ? antrean.filter(a=> a.status === 'dikerjakan') : []; %>
                        <% if (listDikerjakan.length> 0) { %>
                          <% listDikerjakan.forEach(function(item) { %>
                            <div class="p-3.5 rounded-xl bg-blue-50/50 border border-blue-200 text-xs space-y-2">
                              <div class="flex justify-between items-center text-[10px] text-blue-600 font-mono">
                                <span>
                                  <%= item.id %>
                                </span>
                                <span class="font-bold">
                                  <%= item.pit_nomor || 'Pit 1' %> &bull; <%= item.mekanik || 'Pak Vinsen' %>
                                </span>
                              </div>
                              <div>
                                <h5 class="font-bold text-navy-900">
                                  <%= item.tipe_motor %> (<%= item.no_polisi %>)
                                </h5>
                                <p class="text-slate-600 text-[11px] mt-0.5">
                                  <%= item.layanan_nama %>
                                </p>
                              </div>
                              <form action="/admin/antrean/status/<%= item.id %>" method="POST"
                                class="pt-2 border-t border-blue-200">
                                <input type="hidden" name="status" value="selesai" />
                                <button type="submit"
                                  class="w-full py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-[11px] transition flex items-center justify-center gap-1.5">
                                  <i class="fa-solid fa-check text-[9px]"></i>
                                  <span>Tandai Selesai</span>
                                </button>
                              </form>
                            </div>
                            <% }); %>
                              <% } else { %>
                                <p class="text-xs text-slate-400 text-center py-6">Pit sedang kosong.</p>
                                <% } %>
                    </div>
                  </div>

                  <!-- Kolom 3: Selesai Servis -->
                  <div class="bg-white rounded-2xl p-4 border border-emerald-200 shadow-2xs">
                    <div class="flex items-center justify-between pb-3 border-b border-emerald-100 mb-3">
                      <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span>
                        <h4 class="font-extrabold text-xs uppercase text-slate-900 tracking-wider">Selesai Servis</h4>
                      </div>
                      <span
                        class="text-xs font-mono font-bold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200">
                        <%= antrean ? antrean.filter(a=> a.status === 'selesai').length : 0 %>
                      </span>
                    </div>

                    <div class="space-y-3">
                      <% const listSelesai=antrean ? antrean.filter(a=> a.status === 'selesai') : []; %>
                        <% if (listSelesai.length> 0) { %>
                          <% listSelesai.forEach(function(item) { %>
                            <div class="p-3.5 rounded-xl bg-emerald-50/50 border border-emerald-200 text-xs space-y-2">
                              <div class="flex justify-between items-center text-[10px] text-emerald-700 font-mono">
                                <span>
                                  <%= item.id %>
                                </span>
                                <span class="font-bold"><i class="fa-solid fa-check"></i> Siap Diambil</span>
                              </div>
                              <div>
                                <h5 class="font-bold text-navy-900">
                                  <%= item.tipe_motor %> (<%= item.no_polisi %>)
                                </h5>
                                <div class="flex justify-between items-baseline mt-1">
                                  <span class="text-slate-600 text-[11px]">
                                    <%= item.layanan_nama %>
                                  </span>
                                  <span class="font-bold text-navy-900 font-mono">
                                    <%= formatRupiah(item.biaya || 75000) %>
                                  </span>
                                </div>
                              </div>
                              <div class="pt-2 border-t border-emerald-200">
                                <button type="button" data-id="<%= item.id %>" data-nama="<%= item.nama_pelanggan %>"
                                  data-wa="<%= item.no_whatsapp %>" data-motor="<%= item.tipe_motor %>"
                                  data-plat="<%= item.no_polisi %>" data-layanan="<%= item.layanan_nama %>"
                                  data-biaya="<%= item.biaya || 75000 %>" onclick="handleOpenReceiptBtn(this)"
                                  class="w-full py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-[11px] transition flex items-center justify-center gap-1.5 shadow-2xs">
                                  <i class="fa-brands fa-whatsapp text-xs"></i>
                                  <span>Kirim Nota via WA</span>
                                </button>
                              </div>
                            </div>
                            <% }); %>
                              <% } else { %>
                                <p class="text-xs text-slate-400 text-center py-6">Belum ada servis selesai.</p>
                                <% } %>
                    </div>
                  </div>

                </div>

              </div>

              <!-- ═════════════════════════════════════════════════════════════ -->
              <!-- VIEW 3: PESANAN MASUK (INCOMING BOOKING)                      -->
              <!-- ═════════════════════════════════════════════════════════════ -->
              <div id="view-pesanan" class="<%= activeTab === 'pesanan' ? '' : 'hidden' %> space-y-6">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                  <div>
                    <h2 class="text-lg font-black text-navy-900">Pesanan Masuk (Incoming Bookings)</h2>
                    <p class="text-xs text-slate-500">Daftar booking servis online dari pelanggan yang menunggu konfirmasi (US-01).</p>
                  </div>
                  <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-[11px] font-bold self-start sm:self-auto">
                    <i class="fa-solid fa-shield-halved text-emerald-600"></i>
                    <span>Proteksi Anti-Spam &amp; Verifikasi Dua Arah Aktif</span>
                  </div>
                </div>

                <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-2xs">
                  <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs text-slate-700">
                      <thead
                        class="bg-slate-50 border-b border-slate-200 text-slate-500 uppercase text-[10px] font-bold">
                        <tr>
                          <th class="py-3 px-4">No. Booking</th>
                          <th class="py-3 px-4">Pelanggan</th>
                          <th class="py-3 px-4">Motor &amp; Plat</th>
                          <th class="py-3 px-4">Layanan</th>
                          <th class="py-3 px-4">Jadwal</th>
                          <th class="py-3 px-4">Keluhan</th>
                          <th class="py-3 px-4">Status</th>
                          <th class="py-3 px-4 text-center">Aksi Cepat</th>
                        </tr>
                      </thead>
                      <tbody class="divide-y divide-slate-100 font-medium">
                        <% if (bookings && bookings.length> 0) { %>
                          <% bookings.forEach(function(b) { %>
                            <%
                              let cleanWa = String(b.no_whatsapp || '').replace(/[^0-9]/g, '');
                              if (cleanWa.startsWith('08')) {
                                cleanWa = '628' + cleanWa.slice(2);
                              } else if (!cleanWa.startsWith('62') && cleanWa.length > 8) {
                                cleanWa = '62' + cleanWa;
                              }
                              const waKonfirmasiMsg = encodeURIComponent(`Halo Mas/Mbak ${b.nama_pelanggan}, kami dari Bengkel Shift Garage ingin mengonfirmasi booking servis ${b.layanan_nama} untuk motor ${b.tipe_motor} (${b.no_polisi}) pada ${b.tanggal_booking} jam ${b.jam_booking}. Apakah jadwal sudah sesuai untuk kami siapkan di Pit? Terima kasih!`);
                            %>
                            <tr class="hover:bg-slate-50 transition">
                              <td class="py-3 px-4 font-mono font-bold text-navy-900">
                                <%= b.id %>
                              </td>
                              <td class="py-3 px-4">
                                <span class="font-bold text-slate-900 block">
                                  <%= b.nama_pelanggan %>
                                </span>
                                <div class="flex items-center gap-1.5 mt-0.5">
                                  <span class="text-slate-500 font-mono text-[11px]">
                                    <%= b.no_whatsapp %>
                                  </span>
                                  <% if (cleanWa) { %>
                                    <a href="https://wa.me/<%= cleanWa %>?text=<%= waKonfirmasiMsg %>" target="_blank"
                                      class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-emerald-100 hover:bg-emerald-200 text-emerald-800 text-[9px] font-bold transition"
                                      title="Kirim Chat Konfirmasi WA">
                                      <i class="fa-brands fa-whatsapp text-emerald-600"></i>
                                      <span>Chat WA</span>
                                    </a>
                                  <% } %>
                                </div>
                              </td>
                              <td class="py-3 px-4">
                                <span class="font-bold text-slate-800 block">
                                  <%= b.tipe_motor %>
                                </span>
                                <span class="text-slate-400 font-mono text-[11px]">
                                  <%= b.no_polisi %>
                                </span>
                              </td>
                              <td class="py-3 px-4 font-semibold text-slate-700">
                                <%= b.layanan_nama %>
                              </td>
                              <td class="py-3 px-4 font-mono text-[11px]">
                                <span>
                                  <%= b.tanggal_booking %>
                                </span>
                                <span class="text-slate-400 block">
                                  <%= b.jam_booking %>
                                </span>
                              </td>
                              <td class="py-3 px-4 max-w-xs text-slate-600 truncate" title="<%= b.keluhan %>">
                                <%= b.keluhan %>
                              </td>
                              <td class="py-3 px-4">
                                <% if (b.status==='menunggu_konfirmasi' ) { %>
                                  <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">Menunggu</span>
                                <% } else if (b.status === 'dibatalkan') { %>
                                  <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800">Dibatalkan</span>
                                <% } else { %>
                                  <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">Masuk Pit</span>
                                <% } %>
                              </td>
                              <td class="py-3 px-4 text-center">
                                <% if (b.status==='menunggu_konfirmasi' ) { %>
                                  <div class="flex items-center justify-center gap-1.5 flex-wrap">
                                    <form action="/admin/booking/terima/<%= b.id %>" method="POST" class="inline">
                                      <button type="submit"
                                        class="px-2.5 py-1.5 rounded-lg bg-gold-400 hover:bg-gold-300 text-navy-950 font-black text-xs transition flex items-center gap-1 shadow-gold-sm"
                                        title="Terima & Masukkan ke Pit">
                                        <i class="fa-solid fa-check text-[10px]"></i>
                                        <span>Terima Masuk Pit</span>
                                      </button>
                                    </form>
                                    <form action="/admin/booking/tolak/<%= b.id %>" method="POST" class="inline" onsubmit="return confirm('Tolak pesanan <%= b.id %> ini?')">
                                      <button type="submit"
                                        class="px-2 py-1.5 rounded-lg bg-slate-100 hover:bg-rose-50 hover:text-rose-700 text-slate-600 font-bold text-xs transition"
                                        title="Tolak Pesanan">
                                        <i class="fa-solid fa-xmark text-[10px]"></i>
                                      </button>
                                    </form>
                                    <form action="/admin/booking/hapus/<%= b.id %>" method="POST" class="inline" onsubmit="return confirm('Hapus permanen pesanan <%= b.id %> ini?')">
                                      <button type="submit"
                                        class="px-2 py-1.5 rounded-lg bg-slate-100 hover:bg-rose-600 hover:text-white text-slate-400 font-bold text-xs transition"
                                        title="Hapus Permanen">
                                        <i class="fa-solid fa-trash-can text-[10px]"></i>
                                      </button>
                                    </form>
                                  </div>
                                <% } else if (b.status === 'dibatalkan') { %>
                                  <div class="flex items-center justify-center gap-2">
                                    <span class="text-rose-500 text-xs font-semibold">Dibatalkan</span>
                                    <form action="/admin/booking/hapus/<%= b.id %>" method="POST" class="inline" onsubmit="return confirm('Hapus permanen pesanan <%= b.id %>?')">
                                      <button type="submit" class="text-slate-400 hover:text-rose-600 text-xs transition" title="Hapus Permanen">
                                        <i class="fa-solid fa-trash-can"></i>
                                      </button>
                                    </form>
                                  </div>
                                <% } else { %>
                                  <span class="text-emerald-600 text-xs font-bold inline-flex items-center gap-1">
                                    <i class="fa-solid fa-circle-check"></i>
                                    <span>Aktif di Pit</span>
                                  </span>
                                <% } %>
                              </td>
                            </tr>
                            <% }); %>
                              <% } else { %>
                                <tr>
                                  <td colspan="8" class="py-8 text-center text-slate-400">Belum ada pesanan booking.
                                  </td>
                                </tr>
                                <% } %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>

              <!-- ═════════════════════════════════════════════════════════════ -->
              <!-- VIEW 4: KATALOG LAYANAN (DATABASE POSTGRESQL CRUD)           -->
              <!-- ═════════════════════════════════════════════════════════════ -->
              <div id="view-katalog" class="<%= activeTab === 'katalog' ? '' : 'hidden' %> space-y-6">
                <div class="flex items-center justify-between">
                  <div>
                    <h2 class="text-lg font-black text-navy-900">Katalog Layanan Bengkel (PostgreSQL)</h2>
                    <p class="text-xs text-slate-500">Kelola master data servis dan tarif pengerjaan di database.</p>
                  </div>
                  <button onclick="openTambahLayananModal()" type="button"
                    class="px-4 py-2.5 rounded-xl bg-navy-900 hover:bg-navy-850 text-gold-400 font-black text-xs transition shadow-navy flex items-center gap-2">
                    <i class="fa-solid fa-plus text-xs"></i>
                    <span>Tambah Layanan Baru</span>
                  </button>
                </div>

                <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-2xs">
                  <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs text-slate-700">
                      <thead
                        class="bg-slate-50 border-b border-slate-200 text-slate-500 uppercase text-[10px] font-bold">
                        <tr>
                          <th class="py-3 px-4">Kode ID</th>
                          <th class="py-3 px-4">Nama Layanan</th>
                          <th class="py-3 px-4">Kategori</th>
                          <th class="py-3 px-4">Tarif</th>
                          <th class="py-3 px-4">Durasi Pit</th>
                          <th class="py-3 px-4">Status</th>
                          <th class="py-3 px-4 text-center">Aksi CRUD</th>
                        </tr>
                      </thead>
                      <tbody class="divide-y divide-slate-100 font-medium">
                        <% if (layanan && layanan.length> 0) { %>
                          <% layanan.forEach(function(item) { %>
                            <tr class="hover:bg-slate-50 transition">
                              <td class="py-3 px-4 font-mono font-bold text-navy-900">
                                <%= item.id %>
                              </td>
                              <td class="py-3 px-4">
                                <span class="font-bold text-slate-900 block">
                                  <%= item.nama %>
                                </span>
                                <span class="text-slate-500 text-[11px] block max-w-sm truncate">
                                  <%= item.deskripsi %>
                                </span>
                              </td>
                              <td class="py-3 px-4">
                                <span
                                  class="px-2 py-0.5 rounded-md bg-slate-100 text-[10px] font-bold border border-slate-200">
                                  <%= item.kategori %>
                                </span>
                              </td>
                              <td class="py-3 px-4 font-bold text-navy-900 font-mono">
                                <%= formatRupiah(item.hargaMulaiDari || item.harga_mulai_dari) %>
                              </td>
                              <td class="py-3 px-4 font-mono text-slate-600">
                                <%= item.estimasiMenit || item.estimasi_menit %> menit
                              </td>
                              <td class="py-3 px-4">
                                <% if (item.tersedia) { %>
                                  <span
                                    class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">Tersedia</span>
                                  <% } else { %>
                                    <span
                                      class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-500">Nonaktif</span>
                                    <% } %>
                              </td>
                              <td class="py-3 px-4 text-center">
                                <div class="flex items-center justify-center gap-1.5">
                                  <button type="button" data-id="<%= item.id %>" data-nama="<%= item.nama %>"
                                    data-kategori="<%= item.kategori %>"
                                    data-harga="<%= item.hargaMulaiDari || item.harga_mulai_dari %>"
                                    data-durasi="<%= item.estimasiMenit || item.estimasi_menit %>"
                                    data-deskripsi="<%= item.deskripsi || '' %>" data-tersedia="<%= item.tersedia %>"
                                    onclick="handleEditBtn(this)"
                                    class="w-7 h-7 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition flex items-center justify-center text-xs"
                                    title="Edit">
                                    <i class="fa-regular fa-pen-to-square"></i>
                                  </button>
                                  <form action="/layanan/delete/<%= item.id %>" method="POST"
                                    onsubmit="return confirm('Hapus layanan <%= item.nama %>?')">
                                    <button type="submit"
                                      class="w-7 h-7 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-600 transition flex items-center justify-center text-xs"
                                      title="Hapus">
                                      <i class="fa-regular fa-trash-can"></i>
                                    </button>
                                  </form>
                                </div>
                              </td>
                            </tr>
                            <% }); %>
                              <% } %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>

              <!-- ═════════════════════════════════════════════════════════════ -->
              <!-- VIEW 5: ASISTEN AI BENGKEL (PAK VINSEN)                       -->
              <!-- ═════════════════════════════════════════════════════════════ -->
              <div id="view-ai-admin" class="<%= activeTab === 'ai-admin' ? '' : 'hidden' %> space-y-6">
                <div>
                  <div class="flex items-center gap-2 mb-1">
                    <h2 class="text-lg font-black text-navy-900">Asisten AI Bengkel &amp; Auto-CRUD (Ruang Kerja Pak Vinsen)</h2>
                    <span class="px-2 py-0.5 rounded-full bg-gold-400 text-navy-950 text-[10px] font-black uppercase shadow-xs">AI Agent Active</span>
                  </div>
                  <p class="text-xs text-slate-500">Mendukung eksekusi perintah CRUD database langsung via chat (Tambah Layanan, Ubah Tarif, Geser Antrean Pit), serta konsultasi teknis motor &amp; materi promosi WA.</p>
                </div>

                <!-- Action Prompt Chips Grid (4 Chips: 2 CRUD Actions, 2 Technical/Promo) -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
                  <div
                    onclick="sendAdminAiPrompt('Tolong tambahkan paket servis baru: Pembersihan Karburator & Jetting, kategori Perawatan, harga 45000, estimasi 25 menit, deskripsi Bongkar bersihkan karburator spuyer pilot jet main jet.')"
                    class="bg-white p-3.5 rounded-xl border border-slate-200 shadow-2xs hover:border-gold-400 cursor-pointer transition group">
                    <div class="flex items-center gap-1.5 text-navy-900 font-bold text-xs group-hover:text-gold-600">
                      <span>⚡ + Tambah Layanan AI</span>
                    </div>
                    <p class="text-[11px] text-slate-500 mt-1">"Tambah servis Karburator Rp 45.000"</p>
                  </div>
