  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- TOAST NOTIFICATION CONTAINER                                            -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <div id="toastContainer" class="fixed bottom-6 right-6 z-50 flex flex-col gap-2 pointer-events-none"></div>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- JAVASCRIPT LOGIC UNTUK CRUD                                             -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <script>
    let hapusTargetId = null;

    // Toast Generator
    function showToast(message, type = 'success') {
      const container = document.getElementById('toastContainer');
      const toast = document.createElement('div');
      const isError = type === 'error';
      toast.className = `pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-2xl shadow-dropdown border text-xs font-bold transition-all duration-300 transform translate-y-2 opacity-0 ${
        isError ? 'bg-slate-900 text-white border-rose-500/50' : 'bg-slate-900 text-white border-emerald-500/50'
      }`;
      toast.innerHTML = `
        <span class="w-6 h-6 rounded-lg ${isError ? 'bg-rose-500/20 text-rose-400' : 'bg-emerald-500/20 text-emerald-400'} flex items-center justify-center">
          <i class="fa-solid ${isError ? 'fa-circle-xmark' : 'fa-circle-check'} text-xs"></i>
        </span>
        <span class="text-white">${message}</span>
      `;
      container.appendChild(toast);

      requestAnimationFrame(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
      });

      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 250);
      }, 3200);
    }

    // Modal Control Tambah
    function bukaModalTambah() {
      document.getElementById('modalTambah').classList.remove('hidden');
    }
    function tutupModalTambah() {
      document.getElementById('modalTambah').classList.add('hidden');
      document.getElementById('formTambah').reset();
    }

    // Modal Control Edit
    async function bukaModalEdit(id) {
      try {
        const res = await fetch(`/api/produk/${id}`);
        const result = await res.json();
        if (!result.sukses || !result.data) {
          showToast(result.pesan || 'Gagal memuat rincian data', 'error');
          return;
        }

        const item = result.data;
        document.getElementById('editId').value = item.id;
        document.getElementById('editIdLabel').textContent = item.id;
        document.getElementById('editDisplayId').value = item.id;
        document.getElementById('editNama').value = item.nama;
        document.getElementById('editKategori').value = item.kategori;
        document.getElementById('editHarga').value = item.hargaMulaiDari;
        document.getElementById('editEstimasi').value = item.estimasiMenit;
        document.getElementById('editDeskripsi').value = item.deskripsi || '';
        document.getElementById('editTersedia').checked = Boolean(item.tersedia);

        document.getElementById('modalEdit').classList.remove('hidden');
      } catch (err) {
        showToast('Kesalahan jaringan: ' + err.message, 'error');
      }
    }
    function tutupModalEdit() {
      document.getElementById('modalEdit').classList.add('hidden');
    }

    // Modal Detail
    async function lihatDetail(id) {
      try {
        const res = await fetch(`/api/produk/${id}`);
        const result = await res.json();
        if (!result.sukses || !result.data) {
          showToast(result.pesan || 'Data tidak ditemukan', 'error');
          return;
        }
        const item = result.data;
        document.getElementById('detailBadgeId').textContent = item.id;

        const katBadge = document.getElementById('detailKategori');
        katBadge.textContent = item.kategori;
        if (item.kategori === 'Perawatan') katBadge.className = 'text-[11px] font-bold px-3 py-0.5 rounded-full border bg-blue-50 text-blue-700 border-blue-200';
        else if (item.kategori === 'Penggantian Suku Cadang') katBadge.className = 'text-[11px] font-bold px-3 py-0.5 rounded-full border bg-purple-50 text-purple-700 border-purple-200';
        else if (item.kategori === 'Keselamatan') katBadge.className = 'text-[11px] font-bold px-3 py-0.5 rounded-full border bg-amber-50 text-amber-800 border-amber-200';
        else if (item.kategori === 'Perbaikan Besar') katBadge.className = 'text-[11px] font-bold px-3 py-0.5 rounded-full border bg-rose-50 text-rose-700 border-rose-200';
        else katBadge.className = 'text-[11px] font-bold px-3 py-0.5 rounded-full border bg-emerald-50 text-emerald-700 border-emerald-200';

        document.getElementById('detailNama').textContent = item.nama;
        document.getElementById('detailDeskripsi').textContent = item.deskripsi || 'Tidak ada catatan pengerjaan khusus.';
        document.getElementById('detailHarga').textContent = item.hargaMulaiDari === 0 ? 'Gratis' : 'Rp ' + Number(item.hargaMulaiDari).toLocaleString('id-ID');
        document.getElementById('detailEstimasi').textContent = item.estimasiMenit + ' Menit';
        document.getElementById('detailEndpoint').textContent = `/api/produk/${item.id}`;

        const statusEl = document.getElementById('detailStatus');
        if (item.tersedia) {
          statusEl.className = 'font-bold text-emerald-700 flex items-center gap-1.5';
          statusEl.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Siap Dipesan';
        } else {
          statusEl.className = 'font-bold text-slate-500 flex items-center gap-1.5';
          statusEl.innerHTML = '<span class="w-2 h-2 rounded-full bg-slate-400"></span> Nonaktif / Penuh';
        }

        document.getElementById('modalDetail').classList.remove('hidden');
      } catch (err) {
        showToast('Kesalahan memuat rincian: ' + err.message, 'error');
      }
    }
    function tutupModalDetail() {
      document.getElementById('modalDetail').classList.add('hidden');
    }

    // Modal Hapus
    function konfirmasiHapus(id, nama) {
      hapusTargetId = id;
      document.getElementById('hapusItemNama').textContent = `"${nama}" (${id})`;
      document.getElementById('modalHapus').classList.remove('hidden');
    }
    function tutupModalHapus() {
      document.getElementById('modalHapus').classList.add('hidden');
      hapusTargetId = null;
    }

    // CRUD: POST /api/produk
    async function handleTambah(e) {
      e.preventDefault();
      const form = e.target;
      const formData = new FormData(form);
      const payload = {
        id: formData.get('id'),
        nama: formData.get('nama'),
        kategori: formData.get('kategori'),
        deskripsi: formData.get('deskripsi'),
        hargaMulaiDari: formData.get('hargaMulaiDari'),
        estimasiMenit: formData.get('estimasiMenit'),
        tersedia: form.querySelector('#tersediaTambah').checked,
      };

      const btn = document.getElementById('btnSubmitTambah');
      btn.disabled = true;
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Menyimpan...';

      try {
        const res = await fetch('/api/produk', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const result = await res.json();
        if (res.ok && result.sukses) {
          showToast('Paket layanan berhasil ditambahkan ke database!');
          tutupModalTambah();
          setTimeout(() => location.reload(), 450);
        } else {
          showToast(result.pesan || 'Gagal menyimpan data', 'error');
        }
      } catch (err) {
        showToast('Kesalahan jaringan: ' + err.message, 'error');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Simpan ke Database';
      }
    }

    // CRUD: PUT /api/produk/:id
    async function handleEdit(e) {
      e.preventDefault();
      const id = document.getElementById('editId').value;
      const payload = {
        nama: document.getElementById('editNama').value,
        kategori: document.getElementById('editKategori').value,
        deskripsi: document.getElementById('editDeskripsi').value,
        hargaMulaiDari: document.getElementById('editHarga').value,
        estimasiMenit: document.getElementById('editEstimasi').value,
        tersedia: document.getElementById('editTersedia').checked,
      };

      const btn = document.getElementById('btnSubmitEdit');
      btn.disabled = true;
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Memperbarui...';

      try {
        const res = await fetch(`/api/produk/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const result = await res.json();
        if (res.ok && result.sukses) {
          showToast('Paket layanan berhasil diperbarui!');
          tutupModalEdit();
          setTimeout(() => location.reload(), 450);
        } else {
          showToast(result.pesan || 'Gagal memperbarui data', 'error');
        }
      } catch (err) {
        showToast('Kesalahan jaringan: ' + err.message, 'error');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Simpan Perubahan';
      }
    }

    // CRUD: DELETE /api/produk/:id
    async function eksekusiHapus() {
      if (!hapusTargetId) return;
      const btn = document.getElementById('btnConfirmHapus');
      btn.disabled = true;
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Menghapus...';

      try {
        const res = await fetch(`/api/produk/${hapusTargetId}`, {
          method: 'DELETE',
        });
        const result = await res.json();
        if (res.ok && result.sukses) {
          showToast('Paket layanan berhasil dihapus dari database!');
          tutupModalHapus();
          setTimeout(() => location.reload(), 450);
        } else {
          showToast(result.pesan || 'Gagal menghapus data', 'error');
        }
      } catch (err) {
        showToast('Kesalahan jaringan: ' + err.message, 'error');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Hapus Data';
      }
    }

    // Live Filters (Search, Category, Status)
    const searchInput = document.getElementById('searchInput');
    const kategoriFilter = document.getElementById('kategoriFilter');
    const statusFilter = document.getElementById('statusFilter');

    function applyFilter() {
      const q = searchInput.value.toLowerCase().trim();
      const kat = kategoriFilter.value.toLowerCase();
      const stat = statusFilter.value.toLowerCase();
      const rows = document.querySelectorAll('#tableBody tr[data-id]');
      let visible = 0;

      rows.forEach(row => {
        const nama = row.getAttribute('data-nama');
        const rkat = row.getAttribute('data-kategori');
        const desk = row.getAttribute('data-deskripsi');
        const id = row.getAttribute('data-id').toLowerCase();
        const rstat = row.getAttribute('data-status');

        const matchSearch = !q || nama.includes(q) || rkat.includes(q) || desk.includes(q) || id.includes(q);
        const matchKategori = (kat === 'all') || (rkat === kat);
        const matchStatus = (stat === 'all') || (rstat === stat);

        if (matchSearch && matchKategori && matchStatus) {
          row.style.display = '';
          visible++;
        } else {
          row.style.display = 'none';
        }
      });

      const countEl = document.getElementById('visibleCount');
      if (countEl) countEl.textContent = visible;
    }

    if (searchInput) {
      searchInput.addEventListener('input', applyFilter);
      window.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          searchInput.focus();
        }
      });
    }
    if (kategoriFilter) kategoriFilter.addEventListener('change', applyFilter);
    if (statusFilter) statusFilter.addEventListener('change', applyFilter);

    function refreshData() {
      location.reload();
    }
  </script>

