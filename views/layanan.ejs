            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- CLIENT JAVASCRIPT: POS KASIR, TABS, WHATSAPP & MODALS         -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <script>
              // Tab Switcher for Sidebar
              function switchAdminTab(tabId) {
                const allTabs = ['pos', 'kanban', 'pesanan', 'katalog', 'ai-admin'];
                allTabs.forEach(t => {
                  const view = document.getElementById('view-' + t);
                  const btn = document.getElementById('sidebarBtn-' + t);
                  if (view) {
                    if (t === tabId) {
                      view.classList.remove('hidden');
                    } else {
                      view.classList.add('hidden');
                    }
                  }
                  if (btn) {
                    if (t === tabId) {
                      btn.classList.add('bg-navy-900', 'text-gold-400', 'font-black', 'shadow-sm');
                      btn.classList.remove('text-slate-600', 'hover:bg-slate-100');
                    } else {
                      btn.classList.remove('bg-navy-900', 'text-gold-400', 'font-black', 'shadow-sm');
                      btn.classList.add('text-slate-600', 'hover:bg-slate-100');
                    }
                  }
                });
                window.scrollTo({ top: 0, behavior: 'smooth' });
              }

              // Customer Selector in POS
              function handleCustomerSelect(select) {
                const parts = select.value.split('|');
                if (parts.length >= 4) {
                  document.getElementById('posVehicleDisplay').innerHTML = parts[2] + ' &bull; ' + parts[3];
                }
              }

              // POS Cart State
              let posCart = [
                { id: 'L-02', nama: 'Tune-Up Injeksi Komplit', harga: 150000, qty: 1 }
              ];

              function renderPosCart() {
                const container = document.getElementById('orderItemsContainer');
                const totalDisplay = document.getElementById('orderTotalDisplay');
                if (!container || !totalDisplay) return;

                container.innerHTML = '';
                let grandTotal = 0;

                if (posCart.length === 0) {
                  container.innerHTML = '<p class="text-xs text-slate-400 text-center py-6">Belum ada item dipilih.</p>';
                } else {
                  posCart.forEach((item, idx) => {
                    const subtotal = item.harga * item.qty;
                    grandTotal += subtotal;

                    const row = document.createElement('div');
                    row.className = 'flex items-center justify-between gap-2 p-2.5 rounded-xl bg-slate-50 border border-slate-200/80 text-xs';
                    row.innerHTML = `
            <div class="flex-1 min-w-0">
              <h5 class="font-bold text-navy-900 truncate">${escapeHtml(item.nama)}</h5>
              <span class="text-[11px] font-mono text-gold-600 font-black">Rp ${subtotal.toLocaleString('id-ID')}</span>
            </div>
            <div class="flex items-center gap-1.5 shrink-0">
              <button type="button" onclick="changeQty(${idx}, -1)" class="w-6 h-6 rounded-md bg-white border border-slate-200 text-slate-600 hover:bg-slate-100 flex items-center justify-center font-bold text-xs">-</button>
              <span class="w-6 text-center font-bold text-xs">${item.qty}</span>
              <button type="button" onclick="changeQty(${idx}, 1)" class="w-6 h-6 rounded-md bg-white border border-slate-200 text-slate-600 hover:bg-slate-100 flex items-center justify-center font-bold text-xs">+</button>
            </div>
          `;
                    container.appendChild(row);
                  });
                }

                totalDisplay.textContent = 'Rp ' + grandTotal.toLocaleString('id-ID');
              }

              function addToOrder(button) {
                const id = button.dataset.id;
                const nama = button.dataset.nama;
                const harga = parseInt(button.dataset.harga, 10) || 0;

                const existing = posCart.find(i => i.id === id);
                if (existing) {
                  existing.qty += 1;
                } else {
                  posCart.push({ id, nama, harga, qty: 1 });
                }
                renderPosCart();
              }

              function changeQty(index, delta) {
                if (!posCart[index]) return;
                posCart[index].qty += delta;
                if (posCart[index].qty <= 0) {
                  posCart.splice(index, 1);
                }
                renderPosCart();
              }

              function clearOrderCart() {
                posCart = [];
                renderPosCart();
              }

              // Checkout from POS
              function checkoutPosOrder() {
                if (posCart.length === 0) {
                  alert('Silakan pilih minimal 1 layanan/suku cadang terlebih dahulu!');
                  return;
                }

                const custSelect = document.getElementById('posCustomerSelect');
                const parts = custSelect.value.split('|');
                const nama = parts[0] || 'Pelanggan';
                const wa = parts[1] || '081234567890';
                const motor = parts[2] || 'Motor';
                const plat = parts[3] || 'AB 1234';

                const itemsText = posCart.map(i => `${i.nama} (${i.qty}x)`).join(', ');
                const grandTotal = posCart.reduce((sum, i) => sum + (i.harga * i.qty), 0);

                openReceiptModal('POS-' + Date.now().toString().slice(-4), nama, wa, motor, plat, itemsText, grandTotal);
              }

              // Product Filter & Search
              function filterCategory(cat, btn) {
                document.querySelectorAll('.cat-pill').forEach(p => {
                  p.classList.remove('bg-navy-900', 'text-gold-400', 'font-black', 'shadow-xs');
                  p.classList.add('bg-slate-100', 'text-slate-700');
                });
                btn.classList.remove('bg-slate-100', 'text-slate-700');
                btn.classList.add('bg-navy-900', 'text-gold-400', 'font-black', 'shadow-xs');

                const rows = document.querySelectorAll('.pos-row');
                rows.forEach(r => {
                  if (cat === 'Semua' || r.dataset.cat.toLowerCase().includes(cat.toLowerCase())) {
                    r.classList.remove('hidden');
                  } else {
                    r.classList.add('hidden');
                  }
                });
              }

              function filterPosTable() {
                const q = document.getElementById('posProductSearch').value.toLowerCase().trim();
                const rows = document.querySelectorAll('.pos-row');
                rows.forEach(r => {
                  if (!q || r.dataset.name.includes(q)) {
                    r.classList.remove('hidden');
                  } else {
                    r.classList.add('hidden');
                  }
                });
              }

              // Edit Layanan Button Click
              function handleEditBtn(btn) {
                const id = btn.dataset.id;
                const nama = btn.dataset.nama;
                const kategori = btn.dataset.kategori;
                const tarif = btn.dataset.harga;
                const durasi = btn.dataset.durasi;
                const deskripsi = btn.dataset.deskripsi;
                const tersedia = btn.dataset.tersedia === 'true';

                document.getElementById('editLayananIdDisplay').textContent = 'ID: ' + id;
                document.getElementById('editLayananForm').action = '/layanan/update/' + id;
                document.getElementById('editNama').value = nama;
                document.getElementById('editKategori').value = kategori;
                document.getElementById('editTarif').value = tarif;
                document.getElementById('editDurasi').value = durasi;
                document.getElementById('editDeskripsi').value = deskripsi;
                document.getElementById('editTersedia').checked = tersedia;
                document.getElementById('editLayananModal').classList.remove('hidden');
              }

              // Receipt Modal Handler
              function handleOpenReceiptBtn(btn) {
                openReceiptModal(
                  btn.dataset.id,
                  btn.dataset.nama,
                  btn.dataset.wa,
                  btn.dataset.motor,
                  btn.dataset.plat,
                  btn.dataset.layanan,
                  btn.dataset.biaya
                );
              }

              function openReceiptModal(id, nama, wa, motor, plat, layanan, biaya) {
                document.getElementById('recInvoice').textContent = 'INV-SG-' + id;
                document.getElementById('recNama').textContent = nama;
                document.getElementById('recMotor').textContent = motor + ' (' + plat + ')';
                document.getElementById('recLayanan').textContent = layanan;

                const formattedBiaya = 'Rp ' + Number(biaya).toLocaleString('id-ID');
                document.getElementById('recTotal').textContent = formattedBiaya;

                let cleanWa = String(wa).replace(/\D/g, '');
                if (cleanWa.startsWith('0')) cleanWa = '62' + cleanWa.slice(1);

                const pesanWa =
                  `*NOTA DIGITAL RESMI — SHIFT GARAGE*
Halo Kak *${nama}*, terima kasih telah mempercayakan motor Anda di Shift Garage!

*Rincian Servis:*
• No. Nota: INV-SG-${id}
• Kendaraan: *${motor}* (${plat})
• Layanan: ${layanan}
• Mekanik: Pak Vinsen
• Total Biaya: *${formattedBiaya}*
• Status: *LUNAS & SELESAI*

Garansi pengerjaan berlaku 7 hari. Semoga motor semakin prima dan selamat berkendara! 🏍️`;

                const waUrl = `https://wa.me/${cleanWa}?text=${encodeURIComponent(pesanWa)}`;
                document.getElementById('btnSendWa').setAttribute('href', waUrl);

                document.getElementById('receiptModal').classList.remove('hidden');
              }

              function closeReceiptModal() {
                document.getElementById('receiptModal').classList.add('hidden');
              }

              function handleWaSentToast() {
                setTimeout(() => {
                  alert('Nota digital berhasil disiapkan & dialihkan ke WhatsApp!');
                }, 300);
              }

              // Modals Open/Close
              function openWalkinModal() { document.getElementById('walkinModal').classList.remove('hidden'); }
              function closeWalkinModal() { document.getElementById('walkinModal').classList.add('hidden'); }
              function openTambahLayananModal() { document.getElementById('tambahLayananModal').classList.remove('hidden'); }
              function closeTambahLayananModal() { document.getElementById('tambahLayananModal').classList.add('hidden'); }
              function closeEditLayananModal() { document.getElementById('editLayananModal').classList.add('hidden'); }

              // Admin AI Assistant
              function sendAdminAiPrompt(text) {
                const input = document.getElementById('adminAiInput');
                if (input) {
                  input.value = text;
                  handleAdminAiSubmit(new Event('submit'));
                }
              }

              async function handleAdminAiSubmit(e) {
                if (e) e.preventDefault();
                const input = document.getElementById('adminAiInput');
                const list = document.getElementById('adminAiChatList');
                const loading = document.getElementById('adminAiLoading');
                const msg = input.value.trim();
                if (!msg) return;

                const userRow = document.createElement('div');
                userRow.className = 'flex items-start justify-end gap-2.5';
                userRow.innerHTML = `
        <div class="max-w-xl bg-navy-900 text-white p-3 rounded-2xl text-xs shadow-sm leading-relaxed">
          ${escapeHtml(msg)}
        </div>
        <div class="w-7 h-7 rounded-lg bg-gold-400 text-navy-950 flex items-center justify-center shrink-0 text-xs font-black shadow-xs">
          PV
        </div>
      `;
                list.appendChild(userRow);
                input.value = '';
                loading.classList.remove('hidden');
                list.scrollTop = list.scrollHeight;

                try {
                  const res = await fetch('/api/admin/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: msg }),
                  });
                  const data = await res.json();

                  if (res.ok && data.success && data.data) {
                    const aiRow = document.createElement('div');
                    aiRow.className = 'flex items-start gap-2.5';

                    let actionBadge = '';
                    let actionNotice = '';
                    if (data.data.actionExecuted) {
                      actionBadge = `
                        <div class="mb-2">
                          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-emerald-100 text-emerald-800 text-[10px] font-black uppercase border border-emerald-300">
                            <i class="fa-solid fa-bolt text-emerald-600"></i> Aksi Database Dieksekusi Otomatis
                          </span>
                        </div>
                      `;
                      actionNotice = `
                        <div class="pt-2 border-t border-slate-200 flex items-center justify-between">
                          <span class="text-[10px] text-slate-500 font-medium">Data database telah tersimpan.</span>
                          <button onclick="location.reload()" class="px-2.5 py-1 rounded-lg bg-navy-900 text-gold-400 font-bold text-[10px] hover:bg-navy-800 transition flex items-center gap-1 shadow-2xs">
                            <i class="fa-solid fa-rotate-right"></i> Muat Ulang Tabel
                          </button>
                        </div>
                      `;
                    }

                    aiRow.innerHTML = `
                      <div class="w-8 h-8 rounded-xl bg-gold-400 text-navy-950 flex items-center justify-center shrink-0 text-xs font-black shadow-gold-sm">
                        <i class="fa-solid fa-robot"></i>
                      </div>
                      <div class="max-w-xl bg-slate-50 p-3.5 rounded-2xl text-xs text-slate-800 border border-slate-200 leading-relaxed space-y-1.5">
                        ${actionBadge}
                        <div>${data.data.reply.replace(/\n/g, '<br/>')}</div>
                        ${actionNotice}
                        <div class="pt-1 text-right">
                          <button onclick="navigator.clipboard.writeText('${escapeJsString(data.data.reply)}'); alert('Teks berhasil disalin!')"
                            class="text-[10px] font-bold text-gold-600 hover:text-navy-900">
                            <i class="fa-regular fa-copy"></i> Salin Teks
                          </button>
                        </div>
                      </div>
                    `;
                    list.appendChild(aiRow);
                  } else {
                    alert('Gagal: ' + (data.pesan || data.error || 'Server sibuk'));
                  }
                } catch (err) {
                  alert('Error: ' + err.message);
                } finally {
                  loading.classList.add('hidden');
                  list.scrollTop = list.scrollHeight;
                }
              }

              function escapeHtml(s) {
                return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
              }
              function escapeJsString(s) {
                return s.replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '\\"').replace(/\n/g, '\\n');
              }

              // Initial Render
              document.addEventListener('DOMContentLoaded', () => {
                renderPosCart();
              });
            </script>
  </body>

  </html>