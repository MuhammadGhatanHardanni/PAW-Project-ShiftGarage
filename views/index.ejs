                            <span>Konfirmasi ke WhatsApp Pak Vinsen Sekarang</span>
                            <i class="fa-solid fa-arrow-right text-[10px]"></i>
                          </a>

                          <a href="/"
                            class="block w-full py-2.5 text-center text-xs font-bold text-slate-500 hover:text-navy-900 transition">
