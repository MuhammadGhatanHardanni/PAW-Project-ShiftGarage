    <!-- Formulir Reservasi Jadwal Servis Terhubung PostgreSQL           -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <section id="booking" class="py-20 bg-slate-50/70 border-t border-slate-100">
      <div class="max-w-3xl mx-auto px-4 sm:px-6">

        <div class="text-center space-y-2 mb-10">
          <span class="text-xs font-black tracking-widest text-slate-500 uppercase block">
            RESERVASI MUDAH
          </span>
          <h2 class="text-3xl font-black text-navy-900 tracking-tight">
            Formulir Booking Servis Online
          </h2>
          <p class="text-xs sm:text-sm text-slate-500">
            Daftarkan jadwal perawatan motormu dalam waktu kurang dari 3 menit tanpa antre fisik di lokasi.
          </p>
        </div>

        <div class="bg-white rounded-3xl p-6 sm:p-9 border border-slate-200 shadow-sm">
          <form action="/booking/kirim" method="POST" class="space-y-4" id="formBookingServis">

            <!-- Honeypot Anti-Bot Field (Hidden from real users, traps spam bots) -->
            <input type="text" name="bengkel_hp_check" value="" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none !important">

            <!-- Row 1: Nama Pemilik & WhatsApp -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Nama Pemilik <span class="text-rose-500">*</span></label>
                <input type="text" name="nama" required minlength="3" placeholder="Contoh: Budi Santoso"
                  class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-navy-900 transition">
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Nomor WhatsApp Aktif <span class="text-rose-500">*</span></label>
                <input type="tel" name="whatsapp" required placeholder="Contoh: 081234567890" inputmode="tel" minlength="10" maxlength="15"
                  class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-navy-900 transition">
                <span class="text-[10px] text-slate-400 mt-1 block">Wajib nomor WA aktif untuk verifikasi slot &amp; nota digital.</span>
              </div>
            </div>

            <!-- Row 2: Model Motor & Plat Nomor -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Model Motor <span class="text-rose-500">*</span></label>
                <input type="text" name="motor" required minlength="3" placeholder="Contoh: Honda Vario 160 / NMAX"
                  class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-navy-900 transition">
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Nomor Polisi (Plat) <span class="text-rose-500">*</span></label>
                <input type="text" name="plat" id="formPlatInput" required minlength="4" maxlength="12" placeholder="Contoh: AB 5928 VG"
                  oninput="this.value = this.value.toUpperCase()"
                  class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-mono font-bold text-slate-800 uppercase focus:bg-white focus:outline-none focus:ring-2 focus:ring-navy-900 transition">
                <span class="text-[10px] text-slate-400 mt-1 block">Untuk pelacakan progres di Pit secara real-time.</span>
              </div>
            </div>

            <!-- Row 3: Layanan, Tanggal, Jam -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Paket Layanan</label>
                <select name="layanan_id" id="formLayananSelect"
                  class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-navy-900 transition">
                  <% if (layanan && layanan.length > 0) { %>
                    <% layanan.forEach(function(item) { %>
                      <option value="<%= item.id %>"><%= item.nama %></option>
                    <% }); %>
                  <% } else { %>
                    <option value="L-01">Servis Rutin Berkala</option>
                  <% } %>
                </select>
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Tanggal Kedatangan</label>
                <input type="date" name="tanggal" value="<%= new Date().toISOString().split('T')[0] %>" required
                  class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-navy-900 transition">
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Jam Kedatangan</label>
                <select name="jam"
                  class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-navy-900 transition">
                  <option value="08:30 WIB">08:30 WIB (Pagi)</option>
                  <option value="10:00 WIB" selected>10:00 WIB (Pagi)</option>
                  <option value="11:30 WIB">11:30 WIB (Siang)</option>
                  <option value="13:30 WIB">13:30 WIB (Siang)</option>
                  <option value="15:00 WIB">15:00 WIB (Sore)</option>
                </select>
              </div>
            </div>

            <!-- Row 4: Catatan Keluhan -->
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Catatan Keluhan Spesifik (Opsional)</label>
              <textarea name="keluhan" id="formKeluhanInput" rows="2"
                placeholder="Catatan keluhan khusus jika ada..."
                class="w-full p-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-navy-900 transition"></textarea>
            </div>

            <!-- Two-Way WhatsApp Verification Notice Banner -->
            <div class="p-3 bg-slate-50 rounded-xl border border-slate-200/80 flex items-center gap-2.5 text-[11px] text-slate-500">
              <i class="fa-solid fa-shield-halved text-gold-500 text-sm shrink-0"></i>
              <span><strong>Two-Way Verification:</strong> Setelah submit, Anda akan mendapatkan ringkasan booking &amp; tombol konfirmasi instan ke WhatsApp Pak Vinsen agar slot servis langsung diamankan.</span>
            </div>

            <!-- Submit Button (Satu-satunya tombol submit di bawah seluruh input) -->
            <div class="pt-2">
              <button type="submit"
                class="w-full py-4 rounded-full bg-gold-400 hover:bg-gold-300 text-navy-950 font-black text-xs shadow-gold transition hover:scale-[1.01] active:scale-[0.99] flex items-center justify-center gap-2">
                <span>Konfirmasi Booking Servis Sekarang</span>
                <i class="fa-solid fa-arrow-right text-[10px]"></i>
              </button>
            </div>

          </form>
        </div>

      </div>
    </section>

