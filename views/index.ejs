  <!-- Interactive Playground Logic -->
  <script>
    let activeCurl = 'curl -s http://localhost:3000/api/status';

    async function executePlayground(endpoint, method) {
      const output = document.getElementById('playgroundOutput');
      const badge = document.getElementById('responseStatus');
      const latencyEl = document.getElementById('responseLatency');
      const curlSnippet = document.getElementById('curlSnippet');

      // Update button styles
      ['/api/status', '/api/produk', '/api/produk/L-01'].forEach(p => {
        const id = p === '/api/status' ? 'tab-status' : (p === '/api/produk' ? 'tab-produk' : 'tab-detail');
        const btn = document.getElementById(id);
        if (btn) {
          if (p === endpoint) {
            btn.className = 'px-3 py-1.5 rounded-xl bg-slateDark-950 text-white font-bold text-[11px] border border-slate-700 transition';
          } else {
            btn.className = 'px-3 py-1.5 rounded-xl bg-slate-900 text-slate-400 font-bold text-[11px] hover:bg-slate-800 hover:text-white transition';
          }
        }
      });

      activeCurl = `curl -s http://localhost:3000${endpoint}`;
      curlSnippet.textContent = activeCurl;
      output.textContent = 'Menghubungi endpoint backend...';

      const start = performance.now();
      try {
        const res = await fetch(endpoint);
        const duration = Math.round(performance.now() - start);
        latencyEl.textContent = `${duration} ms`;

        if (res.ok) {
          badge.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[11px] font-bold bg-emerald-950 text-emerald-400 border border-emerald-800';
          badge.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> ${res.status} ${res.statusText}`;
        } else {
          badge.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[11px] font-bold bg-rose-950 text-rose-400 border border-rose-800';
          badge.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span> ${res.status} ${res.statusText}`;
        }

        const data = await res.json();
        output.textContent = JSON.stringify(data, null, 2);
      } catch (err) {
        latencyEl.textContent = '0 ms';
        badge.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[11px] font-bold bg-rose-950 text-rose-400 border border-rose-800';
        badge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span> Error';
        output.textContent = 'Gagal menghubungi server: ' + err.message;
      }
    }

    function copyCurl() {
      navigator.clipboard.writeText(activeCurl).then(() => {
        const feedback = document.getElementById('copyFeedback');
        feedback.textContent = 'Tersalin!';
        setTimeout(() => feedback.textContent = 'Salin cURL', 2000);
      });
    }

    // Auto-execute on mount
    window.addEventListener('DOMContentLoaded', () => {
      executePlayground('/api/status', 'GET');
    });
  </script>

