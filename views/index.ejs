<%- include('partials/head', { judul }) %>

  <body
    class="bg-white text-slate-900 min-h-screen flex flex-col font-sans text-sm selection:bg-gold-400 selection:text-navy-950">

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 1. TOP NAVBAR (PERSIS STYLE CARWASH / SHIFT GARAGE)             -->
    <!-- Clean Solid White, Logo Icon, Centered Nav, Yellow CTA Button   -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100 shadow-xs transition">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">

        <!-- Logo: Wrench + Motorcycle ShiftGarage.com -->
        <a href="/" class="flex items-center gap-2.5 group">
          <div
            class="w-10 h-10 rounded-xl bg-gold-400 text-navy-950 flex items-center justify-center font-black text-base shadow-gold-sm group-hover:scale-105 transition">
            <i class="fa-solid fa-motorcycle"></i>
          </div>
          <div class="leading-none">
            <span class="text-xl font-black tracking-tight text-navy-900 block">
              ShiftGarage<span class="text-gold-500">.com</span>
            </span>
            <span class="text-[9px] tracking-widest text-slate-400 font-bold uppercase block mt-1">
              BENGKEL MOTOR MANDIRI MODERN
            </span>
          </div>
        </a>

        <!-- Center Navigation Links -->
        <nav class="hidden md:flex items-center gap-8 text-xs font-bold text-slate-600">
          <a href="/" class="text-navy-900 font-extrabold hover:text-gold-500 transition">Beranda</a>
          <a href="#our-services" class="hover:text-navy-900 transition">Layanan</a>
          <a href="#why-choose-us" class="hover:text-navy-900 transition">Tentang Kami</a>
          <a href="#pricing" class="hover:text-navy-900 transition">Daftar Harga</a>
          <a href="#how-it-works" class="hover:text-navy-900 transition">Alur Servis</a>
          <a href="#reviews" class="hover:text-navy-900 transition">Testimoni</a>
          <a href="#tracking-ai" class="hover:text-navy-900 transition">Lacak Plat &amp; AI</a>
        </nav>

        <!-- Right Action: Masuk Staf + Yellow Pill CTA Button + Mobile Menu Toggle -->
        <div class="flex items-center gap-3 sm:gap-5">
          <a href="/admin/login"
            class="hidden sm:inline-flex items-center gap-1.5 text-xs font-bold text-slate-600 hover:text-navy-900 transition">
            <i class="fa-solid fa-lock text-[10px] text-slate-400"></i>
            <span>Masuk Staf</span>
          </a>
          <a href="#booking"
            class="inline-flex items-center gap-2 px-4 sm:px-6 py-2.5 rounded-full bg-gold-400 hover:bg-gold-300 text-navy-950 font-black text-xs shadow-gold-sm hover:scale-105 active:scale-95 transition">
            <span>Booking Servis</span>
            <i class="fa-solid fa-arrow-right text-[10px]"></i>
          </a>
          <button id="mobileMenuBtn" onclick="toggleMobileNav()" type="button" aria-label="Toggle Navigation Menu"
            class="md:hidden w-10 h-10 rounded-xl bg-slate-100 hover:bg-slate-200 text-navy-900 flex items-center justify-center text-sm transition">
            <i id="mobileMenuIcon" class="fa-solid fa-bars"></i>
          </button>
        </div>

      </div>

      <!-- Mobile Dropdown Navigation Menu -->
      <div id="mobileNavMenu"
        class="hidden md:hidden bg-white border-b border-slate-200 px-4 py-4 space-y-1.5 shadow-lg">
        <a href="/" onclick="toggleMobileNav()"
          class="block px-3 py-2 rounded-xl font-black text-navy-900 bg-slate-100 text-xs">Beranda</a>
        <a href="#our-services" onclick="toggleMobileNav()"
          class="block px-3 py-2 rounded-xl font-bold text-slate-700 hover:bg-slate-50 text-xs">Layanan</a>
        <a href="#why-choose-us" onclick="toggleMobileNav()"
          class="block px-3 py-2 rounded-xl font-bold text-slate-700 hover:bg-slate-50 text-xs">Tentang Kami</a>
        <a href="#pricing" onclick="toggleMobileNav()"
          class="block px-3 py-2 rounded-xl font-bold text-slate-700 hover:bg-slate-50 text-xs">Daftar Harga</a>
        <a href="#how-it-works" onclick="toggleMobileNav()"
          class="block px-3 py-2 rounded-xl font-bold text-slate-700 hover:bg-slate-50 text-xs">Alur Servis</a>
        <a href="#reviews" onclick="toggleMobileNav()"
          class="block px-3 py-2 rounded-xl font-bold text-slate-700 hover:bg-slate-50 text-xs">Testimoni</a>
        <a href="#tracking-ai" onclick="toggleMobileNav()"
          class="block px-3 py-2 rounded-xl font-bold text-slate-700 hover:bg-slate-50 text-xs">Lacak Plat &amp; AI</a>
        <div class="pt-2 border-t border-slate-100">
          <a href="/admin/login"
            class="flex items-center gap-2 px-3 py-2 rounded-xl font-bold text-navy-900 hover:bg-slate-50 text-xs">
            <i class="fa-solid fa-shield-halved text-gold-500 text-xs"></i>
            <span>Masuk Staf &amp; Kasir</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Flash Notification Alert -->
    <% if (typeof notif !=='undefined' && notif) { %>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-6">
        <div
          class="p-4 rounded-2xl flex items-center justify-between <%= tipeNotif === 'error' ? 'bg-rose-50 border border-rose-200 text-rose-800' : 'bg-emerald-50 border border-emerald-200 text-emerald-800' %> shadow-xs text-xs font-bold">
          <div class="flex items-center gap-2.5">
            <i
              class="fa-solid <%= tipeNotif === 'error' ? 'fa-triangle-exclamation text-rose-500' : 'fa-circle-check text-emerald-600' %> text-base"></i>
            <span>
              <%= notif %>
            </span>
          </div>
          <a href="/" class="underline opacity-75 hover:opacity-100">Tutup</a>
        </div>
      </div>
      <% } %>

        <main class="flex-1">

          <!-- ═══════════════════════════════════════════════════════════════ -->
          <!-- 2. HERO SECTION (PERSIS SPLIT LAYOUT CARWASH.COM)               -->
          <!-- Latar Deep Dark Navy + Headline Bold + Visual Motor Detailing   -->
          <!-- ═══════════════════════════════════════════════════════════════ -->
          <section class="relative bg-navy-900 text-white overflow-hidden py-16 lg:py-24">

            <!-- Ambient Lighting Halus di Background -->
            <div class="absolute -top-32 -left-32 w-96 h-96 bg-gold-400/10 rounded-full blur-3xl pointer-events-none">
            </div>
            <div class="absolute -bottom-32 right-0 w-96 h-96 bg-sky-500/10 rounded-full blur-3xl pointer-events-none">
            </div>

            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">

                <!-- Sisi Kiri: Headline, Subtitle, Tombol Aksi (7 Cols) -->
                <div class="lg:col-span-7 space-y-6">

                  <!-- Kicker / Eyebrow -->
                  <div
                    class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-navy-800 border border-navy-700 text-[11px] font-extrabold tracking-widest text-gold-400 uppercase">
                    <span class="w-1.5 h-1.5 rounded-full bg-gold-400 animate-pulse"></span>
                    <span>PREMIUM MOTORCYCLE SERVICES</span>
                  </div>

                  <!-- Big Bold Headline (Gaya "A Cleaner Car Makes a Brighter Day") -->
                  <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-tight">
                    Solusi Servis Motor Cepat, <br>
                    Bikin Motormu Lebih <br>
                    <span class="text-gold-400 drop-shadow-sm">Prima &amp; Bertenaga</span>
                  </h1>

                  <!-- Subtitle Deskripsi -->
                  <p class="text-sm sm:text-base text-slate-300 max-w-xl leading-relaxed font-normal">
                    Perawatan motor berkala, tune-up injeksi, dan perbaikan mesin profesional oleh mekanik ahli
                    <strong>Pak Vinsen</strong>. Didukung diagnosa cerdas <em>Google Gemini AI</em>, antrean live
                    transparan, dan struk digital via WhatsApp.
                  </p>

                  <!-- Action Buttons Row (Yellow Pill + Play / AI Pill) -->
                  <div class="pt-2 flex flex-wrap items-center gap-4">
                    <a href="#booking"
                      class="inline-flex items-center gap-2 px-8 py-4 rounded-full bg-gold-400 hover:bg-gold-300 text-navy-950 font-black text-xs shadow-gold transition hover:scale-105 active:scale-95">
                      <span>Booking Servis Sekarang</span>
                      <i class="fa-solid fa-arrow-right text-[10px]"></i>
                    </a>
                    <a href="#tracking-ai"
                      class="inline-flex items-center gap-3 px-6 py-4 rounded-full bg-white/10 hover:bg-white/20 text-white font-bold text-xs border border-white/15 backdrop-blur-md transition">
                      <span
                        class="w-6 h-6 rounded-full bg-gold-400 text-navy-950 flex items-center justify-center text-[10px]">
                        <i class="fa-solid fa-play pl-0.5"></i>
                      </span>
                      <span>Lacak Plat &amp; Tanya AI</span>
                    </a>
                  </div>

                </div>

                <!-- Sisi Kanan: Foto Motor Detailing Clean & Sharp (5 Cols) -->
                <div class="lg:col-span-5">
                  <div class="relative rounded-3xl overflow-hidden shadow-navy border border-navy-700/80 group">
                    <img
                      src="https://images.unsplash.com/photo-1558981403-c5f9899a28bc?auto=format&fit=crop&w=1200&q=80"
                      alt="Servis Motor Shift Garage"
                      class="w-full h-96 lg:h-[460px] object-cover object-center group-hover:scale-105 transition duration-700">

                    <!-- Dark Vignette Overlay -->
                    <div class="absolute inset-0 bg-gradient-to-t from-navy-950/80 via-transparent to-transparent">
                    </div>

                    <!-- Floating Small Pill Status di Foto -->
                    <div
                      class="absolute bottom-5 left-5 right-5 bg-navy-900/90 backdrop-blur-md border border-navy-700 p-3.5 rounded-2xl flex items-center justify-between">
                      <div class="flex items-center gap-3">
                        <div
                          class="w-8 h-8 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-xs">
                          <i class="fa-solid fa-shield-halved"></i>
                        </div>
                        <div>
                          <span class="text-xs font-bold text-white block">Pit Operasional Siap</span>
                          <span class="text-[10px] text-slate-400 block">Ditangani Langsung Pak Vinsen</span>
                        </div>
                      </div>
                      <span
                        class="px-2.5 py-1 rounded-full bg-emerald-500/20 text-emerald-400 text-[10px] font-extrabold uppercase">
                        Aktif
                      </span>
                    </div>
                  </div>
                </div>

              </div>
            </div>

          </section>

          <!-- ═══════════════════════════════════════════════════════════════ -->
          <!-- 3. TRUST & FEATURE HIGHLIGHTS STRIP (DI BAWAH HERO)             -->
          <!-- 4 Item Garansi Putih Melayang Bersih                            -->
          <!-- ═══════════════════════════════════════════════════════════════ -->
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-8 relative z-20">
            <div
              class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 sm:p-7 grid grid-cols-2 lg:grid-cols-4 gap-6">

              <!-- Feature 1 -->
              <div class="flex items-center gap-3.5">
                <div
                  class="w-12 h-12 rounded-xl bg-slate-50 border border-slate-100 text-navy-900 flex items-center justify-center text-xl shrink-0">
                  <i class="fa-solid fa-user-gear text-navy-900"></i>
                </div>
                <div>
                  <h4 class="font-black text-slate-900 text-xs sm:text-sm">Mekanik Berpengalaman</h4>
                  <p class="text-[11px] text-slate-500 mt-0.5">Ditangani langsung Pak Vinsen</p>
                </div>
              </div>

              <!-- Feature 2 -->
              <div class="flex items-center gap-3.5">
                <div
                  class="w-12 h-12 rounded-xl bg-slate-50 border border-slate-100 text-navy-900 flex items-center justify-center text-xl shrink-0">
                  <i class="fa-solid fa-wand-magic-sparkles text-navy-900"></i>
                </div>
                <div>
                  <h4 class="font-black text-slate-900 text-xs sm:text-sm">Diagnosa Gemini AI</h4>
                  <p class="text-[11px] text-slate-500 mt-0.5">Analisa keluhan motor cepat</p>
                </div>
              </div>

              <!-- Feature 3 -->
              <div class="flex items-center gap-3.5">
                <div
                  class="w-12 h-12 rounded-xl bg-slate-50 border border-slate-100 text-navy-900 flex items-center justify-center text-xl shrink-0">
                  <i class="fa-solid fa-shield-halved text-navy-900"></i>
                </div>
                <div>
                  <h4 class="font-black text-slate-900 text-xs sm:text-sm">Suku Cadang Asli</h4>
                  <p class="text-[11px] text-slate-500 mt-0.5">Jaminan part &amp; oli orisinal</p>
                </div>
              </div>

              <!-- Feature 4 -->
              <div class="flex items-center gap-3.5">
                <div
                  class="w-12 h-12 rounded-xl bg-slate-50 border border-slate-100 text-navy-900 flex items-center justify-center text-xl shrink-0">
                  <i class="fa-solid fa-circle-check text-navy-900"></i>
                </div>
                <div>
                  <h4 class="font-black text-slate-900 text-xs sm:text-sm">100% Kepuasan</h4>
                  <p class="text-[11px] text-slate-500 mt-0.5">Garansi servis &amp; nota digital WA</p>
                </div>
              </div>

            </div>
          </div>

          <!-- ═══════════════════════════════════════════════════════════════ -->
          <!-- 4. "OUR SERVICES" SECTION (PERSIS GRID 6 KARTU CARWASH.COM)     -->
          <!-- Foto Banner Bulat, Judul, Deskripsi, & Tombol Panah Lingkaran   -->
          <!-- ═══════════════════════════════════════════════════════════════ -->
          <section id="our-services" class="py-20 bg-slate-50/70">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

              <!-- Header Section -->
              <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
                <div>
                  <span class="text-xs font-black tracking-widest text-slate-500 uppercase block mb-1">
                    WHAT WE OFFER
                  </span>
                  <h2 class="text-3xl sm:text-4xl font-black text-navy-900 tracking-tight">
                    Our Services
                  </h2>
                  <p class="text-xs sm:text-sm text-slate-500 mt-1 max-w-lg">
                    Dari servis ringan berkala hingga overhaul mesin total &mdash; semua kebutuhan motormu tertangani
                    dengan presisi.
                  </p>
                </div>
                <div>
                  <a href="#pricing"
                    class="inline-flex items-center gap-1.5 text-xs font-extrabold text-navy-900 hover:text-gold-500 transition">
                    <span>View All Services</span>
                    <i class="fa-solid fa-arrow-right text-[10px]"></i>
                  </a>
                </div>
              </div>

              <!-- 6-Grid Cards (3 Columns x 2 Rows) -->
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

                <!-- Service Card 1: Servis Rutin Berkala -->
                <div
                  class="bg-white rounded-3xl p-4 border border-slate-200/90 shadow-sm hover:shadow-xl transition-all duration-300 group flex flex-col justify-between">
                  <div>
                    <div class="relative h-48 rounded-2xl overflow-hidden bg-navy-900 mb-4">
                      <img
                        src="https://images.unsplash.com/photo-1486006920555-c77dce18193b?auto=format&fit=crop&w=600&q=80"
                        alt="Servis Rutin Berkala"
                        class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                      <div
                        class="absolute top-3 left-3 bg-white/95 backdrop-blur-md px-2.5 py-1 rounded-full text-[10px] font-extrabold text-navy-900 shadow-xs">
                        SERVIS BERKALA
                      </div>
                    </div>
                    <h3 class="font-black text-navy-900 text-base mb-1.5 group-hover:text-gold-600 transition">
                      Servis Rutin Berkala
                    </h3>
                    <p class="text-xs text-slate-500 leading-relaxed mb-4">
                      Ganti oli mesin, cek filter udara, setel rem, lumasi rantai/v-belt, dan pengecekan baut bodi.
                    </p>
                  </div>
                  <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
                    <span class="text-xs font-black font-mono text-navy-900">Mulai Rp 75.000</span>
                    <button onclick="selectServiceToBooking('L-01', 'Servis Rutin Berkala')" type="button"
                      class="w-9 h-9 rounded-full bg-navy-900 group-hover:bg-gold-400 group-hover:text-navy-950 text-white flex items-center justify-center transition shadow-xs">
                      <i class="fa-solid fa-arrow-right text-xs"></i>
                    </button>
                  </div>
                </div>

                <!-- Service Card 2: Tune-Up Injeksi & Reset ECU -->
                <div
                  class="bg-white rounded-3xl p-4 border border-slate-200/90 shadow-sm hover:shadow-xl transition-all duration-300 group flex flex-col justify-between">
                  <div>
                    <div class="relative h-48 rounded-2xl overflow-hidden bg-navy-900 mb-4">
                      <img
                        src="https://images.unsplash.com/photo-1558981403-c5f9899a28bc?auto=format&fit=crop&w=600&q=80"
                        alt="Tune-Up Injeksi & Reset ECU"
                        class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                      <div
                        class="absolute top-3 left-3 bg-gold-400 text-navy-950 px-2.5 py-1 rounded-full text-[10px] font-black shadow-xs">
                        FAVORIT MOTOR INJEKSI
                      </div>
                    </div>
                    <h3 class="font-black text-navy-900 text-base mb-1.5 group-hover:text-gold-600 transition">
                      Tune-Up Injeksi &amp; Reset ECU
                    </h3>
                    <p class="text-xs text-slate-500 leading-relaxed mb-4">
                      Pembersihan injector ultrasonik, cleaning throttle body, kalibrasi TPS, dan reset ECU scanner.
                    </p>
                  </div>
                  <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
                    <span class="text-xs font-black font-mono text-navy-900">Mulai Rp 150.000</span>
                    <button onclick="selectServiceToBooking('L-02', 'Tune-Up Injeksi & Reset ECU')" type="button"
                      class="w-9 h-9 rounded-full bg-navy-900 group-hover:bg-gold-400 group-hover:text-navy-950 text-white flex items-center justify-center transition shadow-xs">
                      <i class="fa-solid fa-arrow-right text-xs"></i>
                    </button>
                  </div>
                </div>

                <!-- Service Card 3: Servis Rem & Keselamatan -->
                <div
                  class="bg-white rounded-3xl p-4 border border-slate-200/90 shadow-sm hover:shadow-xl transition-all duration-300 group flex flex-col justify-between">
                  <div>
                    <div class="relative h-48 rounded-2xl overflow-hidden bg-navy-900 mb-4">
                      <img
                        src="https://images.unsplash.com/photo-1568772585407-9361f9bf3a87?auto=format&fit=crop&w=600&q=80"
                        alt="Servis Rem & Safety"
                        class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                      <div
                        class="absolute top-3 left-3 bg-white/95 backdrop-blur-md px-2.5 py-1 rounded-full text-[10px] font-extrabold text-navy-900 shadow-xs">
                        SAFETY BRAKE
                      </div>
                    </div>
                    <h3 class="font-black text-navy-900 text-base mb-1.5 group-hover:text-gold-600 transition">
                      Servis Rem &amp; Keselamatan
                    </h3>
                    <p class="text-xs text-slate-500 leading-relaxed mb-4">
                      Pembersihan kaliper rem cakram, kuras minyak rem DOT4, dan penggantian kampas rem pakem.
                    </p>
                  </div>
                  <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
                    <span class="text-xs font-black font-mono text-navy-900">Mulai Rp 85.000</span>
                    <button onclick="selectServiceToBooking('L-04', 'Servis Rem')" type="button"
                      class="w-9 h-9 rounded-full bg-navy-900 group-hover:bg-gold-400 group-hover:text-navy-950 text-white flex items-center justify-center transition shadow-xs">
                      <i class="fa-solid fa-arrow-right text-xs"></i>
                    </button>
                  </div>
                </div>

                <!-- Service Card 4: Servis CVT Matic & Anti Gredek -->
                <div
                  class="bg-white rounded-3xl p-4 border border-slate-200/90 shadow-sm hover:shadow-xl transition-all duration-300 group flex flex-col justify-between">
                  <div>
                    <div class="relative h-48 rounded-2xl overflow-hidden bg-navy-900 mb-4">
                      <img
                        src="https://images.unsplash.com/photo-1558980664-3a031cf67ea8?auto=format&fit=crop&w=600&q=80"
                        alt="Servis CVT Matic"
                        class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                      <div
                        class="absolute top-3 left-3 bg-white/95 backdrop-blur-md px-2.5 py-1 rounded-full text-[10px] font-extrabold text-navy-900 shadow-xs">
                        MOTOR MATIC
                      </div>
                    </div>
                    <h3 class="font-black text-navy-900 text-base mb-1.5 group-hover:text-gold-600 transition">
                      Servis CVT Matic &amp; Anti Gredek
                    </h3>
                    <p class="text-xs text-slate-500 leading-relaxed mb-4">
                      Pembersihan mangkok ganda, kampas ganda, roller, v-belt, dan pelumasan grease high-temp.
                    </p>
                  </div>
                  <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
                    <span class="text-xs font-black font-mono text-navy-900">Mulai Rp 95.000</span>
                    <button onclick="selectServiceToBooking('L-02', 'Servis CVT Matic')" type="button"
                      class="w-9 h-9 rounded-full bg-navy-900 group-hover:bg-gold-400 group-hover:text-navy-950 text-white flex items-center justify-center transition shadow-xs">
                      <i class="fa-solid fa-arrow-right text-xs"></i>
                    </button>
                  </div>
                </div>

                <!-- Service Card 5: Overhaul Mesin Ringan -->
                <div
                  class="bg-white rounded-3xl p-4 border border-slate-200/90 shadow-sm hover:shadow-xl transition-all duration-300 group flex flex-col justify-between">
                  <div>
                    <div class="relative h-48 rounded-2xl overflow-hidden bg-navy-900 mb-4">
                      <img
                        src="https://images.unsplash.com/photo-1580273916550-e323be2ae537?auto=format&fit=crop&w=600&q=80"
                        alt="Overhaul Mesin Ringan"
                        class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                      <div
                        class="absolute top-3 left-3 bg-white/95 backdrop-blur-md px-2.5 py-1 rounded-full text-[10px] font-extrabold text-navy-900 shadow-xs">
                        PERBAIKAN BESAR
                      </div>
                    </div>
                    <h3 class="font-black text-navy-900 text-base mb-1.5 group-hover:text-gold-600 transition">
                      Overhaul Mesin Ringan
                    </h3>
                    <p class="text-xs text-slate-500 leading-relaxed mb-4">
                      Skur klep, ganti seal klep, pembersihan kerak karbon ruang bakar, paking blok &amp; stel klep.
                    </p>
                  </div>
                  <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
                    <span class="text-xs font-black font-mono text-navy-900">Mulai Rp 450.000</span>
                    <button onclick="selectServiceToBooking('L-03', 'Overhaul Mesin Ringan')" type="button"
                      class="w-9 h-9 rounded-full bg-navy-900 group-hover:bg-gold-400 group-hover:text-navy-950 text-white flex items-center justify-center transition shadow-xs">
                      <i class="fa-solid fa-arrow-right text-xs"></i>
