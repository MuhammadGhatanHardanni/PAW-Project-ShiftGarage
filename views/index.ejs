            </div>
          </section>

        </main>

        <%- include('partials/footer') %>

          <!-- ═══════════════════════════════════════════════════════════════ -->
          <!-- CLIENT JAVASCRIPT HANDLERS                                      -->
          <!-- ═══════════════════════════════════════════════════════════════ -->
          <script>
            function toggleMobileNav() {
              const menu = document.getElementById('mobileNavMenu');
              const icon = document.getElementById('mobileMenuIcon');
              if (!menu) return;
              const isHidden = menu.classList.contains('hidden');
              if (isHidden) {
                menu.classList.remove('hidden');
                if (icon) { icon.classList.remove('fa-bars'); icon.classList.add('fa-xmark'); }
              } else {
                menu.classList.add('hidden');
                if (icon) { icon.classList.remove('fa-xmark'); icon.classList.add('fa-bars'); }
              }
            }

            function selectServiceToBooking(id, nama) {
              const formSelect = document.getElementById('formLayananSelect');
              if (formSelect) {
                formSelect.value = id;
              }
              document.getElementById('booking').scrollIntoView({ behavior: 'smooth' });
            }

            async function lacakStatusMotor() {
              const input = document.getElementById('inputPlatCek');
              const container = document.getElementById('hasilLacakContainer');
              const btn = document.getElementById('btnCekPlat');

              const plat = (input.value || '').trim();
              if (!plat) {
                alert('Silakan masukkan nomor plat motor.');
                input.focus();
                return;
              }

              btn.disabled = true;
              btn.textContent = 'MEMERIKSA...';

              try {
                const res = await fetch('/api/antrean/cek/' + encodeURIComponent(plat));
                const data = await res.json();

                container.classList.remove('hidden');

                if (!data.sukses) {
                  container.innerHTML = `
            <div class="p-4 rounded-2xl bg-amber-500/20 border border-amber-400/40 text-amber-200 text-xs space-y-1">
              <span class="font-bold text-white block">Plat ${plat} Belum Terdaftar</span>
              <p class="text-[11px] text-slate-300">Silakan lakukan pendaftaran melalui form booking di bawah atau hubungi kasir.</p>
            </div>
          `;
                } else {
                  const info = data.data;
                  let badgeStatus = '';
                  let bg = 'bg-navy-850 border-navy-700';

                  if (info.status === 'menunggu' || info.status === 'menunggu_konfirmasi') {
                    badgeStatus = '<span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-amber-400/20 text-amber-300 border border-amber-400/30">Menunggu Giliran Pit</span>';
                  } else if (info.status === 'dikerjakan' || info.status === 'sedang_dikerjakan') {
                    badgeStatus = '<span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-blue-500/20 text-blue-300 border border-blue-400/30">Sedang Dikerjakan</span>';
                  } else {
                    badgeStatus = '<span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-400/30">Selesai Servis</span>';
                    bg = 'bg-emerald-950/40 border-emerald-500/30';
                  }

                  container.innerHTML = `
            <div class="p-4 rounded-2xl ${bg} border space-y-2 text-xs shadow-sm">
              <div class="flex justify-between items-center">
                <span class="font-bold text-white">${info.nama} &bull; <span class="font-mono text-gold-400">${info.plat}</span></span>
                ${badgeStatus}
              </div>
              <p class="text-slate-300 text-[11px]">Layanan: <strong>${info.layanan}</strong> &bull; Mekanik: <strong>${info.mekanik || 'Pak Vinsen'}</strong></p>
              <div class="text-[11px] text-slate-400 pt-1.5 border-t border-navy-700/60 flex justify-between items-center">
                <span>Estimasi Biaya:</span>
                <strong class="text-gold-400 font-mono text-xs">Rp ${(info.biaya || 0).toLocaleString('id-ID')}</strong>
              </div>
            </div>
          `;
                }
              } catch (err) {
                container.classList.remove('hidden');
                container.innerHTML = `<div class="p-3 rounded-xl bg-rose-500/20 border border-rose-400/40 text-rose-200 text-xs">Gagal cek: ${err.message}</div>`;
              } finally {
                btn.disabled = false;
                btn.textContent = 'CEK STATUS';
              }
            }

            function setAndCheckPlat(plat) {
              const input = document.getElementById('inputPlatCek');
              if (input) {
                input.value = plat;
                lacakStatusMotor();
              }
            }

            async function mintaDiagnosaAi() {
              const input = document.getElementById('aiDiagnosisInput');
              const resultCard = document.getElementById('aiResultCard');
              const resultContent = document.getElementById('aiResultContent');
              const btn = document.getElementById('btnKirimAi');

              const message = (input.value || '').trim();
              if (!message) {
                alert('Silakan ketik kendala motor Anda terlebih dahulu.');
                input.focus();
                return;
              }

              btn.disabled = true;
              btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Menganalisis...';

              try {
                const res = await fetch('/api/chat', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ message: message })
                });
                const json = await res.json();

                resultCard.classList.remove('hidden');
                if (json.success && json.data) {
                  resultContent.textContent = json.data.reply;
                } else {
                  resultContent.textContent = json.pesan || 'Maaf, terjadi kendala saat memproses analisa.';
                }
              } catch (err) {
                resultCard.classList.remove('hidden');
                resultContent.textContent = 'Gagal memanggil AI: ' + err.message;
              } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-wand-magic-sparkles text-xs"></i> <span>Analisa Keluhan Sekarang</span>';
              }
            }

            function salinKeluhanKeBooking() {
              const inputAi = document.getElementById('aiDiagnosisInput');
              const inputBooking = document.getElementById('formKeluhanInput');
              if (inputAi && inputBooking) {
                inputBooking.value = inputAi.value;
              }
              document.getElementById('booking').scrollIntoView({ behavior: 'smooth' });
            }
          </script>

  </body>

  </html>