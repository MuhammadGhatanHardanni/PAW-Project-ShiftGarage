                      <span>Bagaimana cara kerja diagnosa keluhan motor Google Gemini AI?</span>
                      <i
                        class="fa-solid fa-chevron-down group-open:rotate-180 transition-transform text-slate-400 text-xs"></i>
                    </summary>
                    <p class="pt-2 text-xs text-slate-500 leading-relaxed">
                      Asisten AI Google Gemini kami dilatih dengan basis pengetahuan otomotif motor roda dua. Anda cukup
                      menceritakan kendala seperti suara berisik atau tarikan gredek, dan AI akan menganalisis komponen
                      mana yang kemungkinan bermasalah sebelum dicek mekanik.
                    </p>
                  </details>

                  <details class="bg-white rounded-2xl border border-slate-200/90 shadow-2xs p-4 group">
                    <summary
                      class="font-extrabold text-navy-900 text-xs cursor-pointer list-none flex items-center justify-between">
                      <span>Kapan saya akan menerima nota pembayaran?</span>
                      <i
                        class="fa-solid fa-chevron-down group-open:rotate-180 transition-transform text-slate-400 text-xs"></i>
                    </summary>
                    <p class="pt-2 text-xs text-slate-500 leading-relaxed">
                      Segera setelah pengerjaan di pit selesai dan diverifikasi di kasir POS, rincian biaya resmi dan
                      nota digital otomatis dikirimkan langsung ke WhatsApp Anda.
                    </p>
                  </details>

                </div>

              </div>

              <!-- ═══════════════════════════════════════════════════════════════ -->
              <!-- MODAL POPUP: TWO-WAY WHATSAPP CONFIRMATION (ANTI-SPAM FLOW)     -->
              <!-- ═══════════════════════════════════════════════════════════════ -->
              <% if (typeof bookingInfo !=='undefined' && bookingInfo) { %>
                <div id="bookingConfirmationModal"
                  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-navy-950/80 backdrop-blur-md">
                  <div
                    class="bg-white rounded-3xl max-w-lg w-full shadow-2xl border border-slate-200 overflow-hidden transform transition-all duration-300">

                    <!-- Top Accent Stripe -->
                    <div class="h-3 bg-gradient-to-r from-emerald-500 via-gold-400 to-emerald-500"></div>

                    <div class="p-6 sm:p-8 space-y-6">

                      <!-- Icon & Header -->
                      <div class="text-center space-y-2">
                        <div
                          class="w-16 h-16 rounded-2xl bg-emerald-100 text-emerald-600 flex items-center justify-center text-3xl mx-auto shadow-sm">
                          <i class="fa-solid fa-circle-check"></i>
                        </div>
                        <h3 class="text-2xl font-black text-navy-900 tracking-tight">
                          Reservasi Berhasil Didaftarkan!
                        </h3>
                        <div
                          class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-100 text-amber-800 text-xs font-bold">
                          <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
                          <span>Status: Menunggu Konfirmasi WhatsApp</span>
                        </div>
                      </div>

                      <!-- Booking Details Card -->
                      <div class="bg-slate-50 rounded-2xl p-4 border border-slate-200/80 space-y-2.5 text-xs">
                        <div class="flex justify-between items-center pb-2 border-b border-slate-200">
                          <span class="text-slate-500 font-semibold">Kode Reservasi:</span>
                          <span class="font-mono font-black text-navy-900 px-2 py-0.5 rounded bg-slate-200/70">
                            <%= bookingInfo.id %>
                          </span>
                        </div>
                        <div class="flex justify-between items-center">
                          <span class="text-slate-500 font-semibold">Nama Pemilik:</span>
                          <span class="font-bold text-navy-900">
                            <%= bookingInfo.nama %>
                          </span>
                        </div>
                        <div class="flex justify-between items-center">
                          <span class="text-slate-500 font-semibold">Motor &amp; Plat:</span>
                          <span class="font-bold text-navy-900 font-mono">
                            <%= bookingInfo.motor %> &bull; <%= bookingInfo.plat %>
                          </span>
                        </div>
                        <div class="flex justify-between items-center">
                          <span class="text-slate-500 font-semibold">Paket Layanan:</span>
                          <span class="font-bold text-gold-600">
                            <%= bookingInfo.layanan %>
                          </span>
                        </div>
                        <div class="flex justify-between items-center pt-2 border-t border-slate-200">
                          <span class="text-slate-500 font-semibold">Jadwal Kedatangan:</span>
                          <span class="font-bold text-slate-800">
                            <%= bookingInfo.tanggal %> (<%= bookingInfo.jam %>)
                          </span>
                        </div>
                      </div>

                      <!-- Security & Importance Notice -->
                      <div
                        class="p-3.5 bg-emerald-50 rounded-2xl border border-emerald-200/80 text-xs text-emerald-900 space-y-1">
                        <div class="flex items-center gap-2 font-black text-emerald-800">
                          <i class="fa-brands fa-whatsapp text-base"></i>
                          <span>Langkah Terakhir: Amankan Slot Anda</span>
                        </div>
                        <p class="text-[11px] leading-relaxed text-emerald-700">
                          Untuk mencegah pesanan palsu dan memastikan suku cadang disiapkan mekanik kami, silakan klik
                          tombol di bawah untuk mengirim pesan otomatis ke WhatsApp <strong>Pak Vinsen</strong>.
                        </p>
                      </div>

                      <!-- WhatsApp Direct Action Button -->
                      <% const waDraft=`Halo Pak Vinsen (Shift Garage), saya baru saja booking servis online:%0A%0A` +
                        `*No. Booking:* ${bookingInfo.id}%0A` + `*Nama:* ${bookingInfo.nama}%0A` + `*Motor:*
                        ${bookingInfo.motor}%0A` + `*Plat:* ${bookingInfo.plat}%0A` + `*Layanan:*
                        ${bookingInfo.layanan}%0A` + `*Jadwal:* ${bookingInfo.tanggal} (${bookingInfo.jam})%0A%0A` +
                        `Mohon konfirmasi ketersediaan slot antrean pit saya. Terima kasih!`; %>
                        <div class="space-y-2.5 pt-1">
                          <a href="https://wa.me/<%= typeof bengkelWa !== 'undefined' ? bengkelWa : '6289620012811' %>?text=<%= waDraft %>"
                            target="_blank"
                            class="w-full py-4 px-6 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white font-black text-xs flex items-center justify-center gap-2.5 shadow-lg shadow-emerald-600/30 hover:scale-[1.02] active:scale-[0.98] transition">
