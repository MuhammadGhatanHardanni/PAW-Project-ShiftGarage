<%- include('partials/head', { judul }) %>

<body class="bg-white text-slate-900 min-h-screen flex flex-col font-sans text-sm selection:bg-buku-600 selection:text-white">

  <!-- ═══ NAVBAR (STYLE BUKU BENGKEL) ═══ -->
  <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-100 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-20">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 group transition">
          <div class="w-10 h-10 rounded-2xl bg-buku-600 text-white flex items-center justify-center font-extrabold text-base shadow-buku-sm group-hover:scale-105 transition">
            <i class="fa-solid fa-wrench"></i>
          </div>
          <div class="leading-tight">
            <span class="text-xl font-extrabold text-slate-900 tracking-tight block"><%= appName %></span>
            <span class="text-[10px] text-buku-600 font-bold uppercase tracking-wider">Sistem Manajemen Bengkel</span>
          </div>
        </a>

        <!-- Nav Links -->
        <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-slate-600">
          <a href="/" class="text-buku-600 font-bold transition">Home</a>
          <a href="#fitur-utama" class="hover:text-slate-900 transition">Fitur</a>
          <a href="#keunggulan" class="hover:text-slate-900 transition">Keunggulan</a>
          <a href="#katalog" class="hover:text-slate-900 transition">Layanan</a>
          <a href="#api-console" class="hover:text-slate-900 transition">API Console</a>
        </nav>

        <!-- Right Action Button -->
        <div class="flex items-center gap-3">
          <a href="/api/status" target="_blank" class="hidden sm:inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100 transition">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>API Status</span>
          </a>
          <a href="/layanan"
            class="px-5 py-2.5 rounded-full bg-buku-600 hover:bg-buku-700 text-white text-xs sm:text-sm font-bold shadow-buku-sm hover:shadow-buku transition-all duration-200 active:scale-95 flex items-center gap-2">
            <i class="fa-solid fa-sliders text-xs"></i>
            <span>Kelola Layanan (CRUD)</span>
          </a>
        </div>
      </div>
    </div>
  </header>

  <main class="flex-1">
    <!-- ═══ 1. HERO SECTION (PERSIS DENGAN REFERENSI BUKU BENGKEL) ═══ -->
    <section class="py-12 sm:py-20 px-4 sm:px-6 lg:px-8 relative overflow-hidden bg-gradient-to-b from-slate-50/80 to-white">
      <div class="max-w-7xl mx-auto grid lg:grid-cols-12 gap-12 items-center">

        <!-- Left Column: Copywriting & CTA -->
        <div class="lg:col-span-6 text-center lg:text-left">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-buku-50 text-buku-700 text-xs font-bold mb-6 border border-buku-100">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Tugas PAW Pertemuan 7 &bull; PostgreSQL MVC</span>
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-[56px] font-black text-slate-900 tracking-tight leading-[1.12]">
            Solusi Terbaik untuk Mengelola Bengkelmu!
          </h1>

          <p class="mt-6 text-slate-600 text-base sm:text-lg leading-relaxed max-w-xl mx-auto lg:mx-0">
            Ubah bengkel Anda menjadi bengkel profesional dengan solusi pengelolaan modern dari <strong><%= appName %></strong>. Terintegrasi langsung dengan database PostgreSQL dan RESTful API.
          </p>

          <div class="mt-8 flex flex-wrap items-center justify-center lg:justify-start gap-4">
            <a href="/layanan"
              class="px-7 py-3.5 rounded-full bg-buku-600 hover:bg-buku-700 text-white font-bold text-sm shadow-buku transition-all duration-150 active:scale-95 flex items-center gap-2">
              <span>Buka Dasbor CRUD</span>
              <i class="fa-solid fa-arrow-right text-xs"></i>
            </a>
            <a href="#api-console"
              class="px-7 py-3.5 rounded-full border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 font-bold text-sm shadow-xs transition flex items-center gap-2">
              <i class="fa-solid fa-terminal text-buku-600 text-xs"></i>
              <span>Coba REST API</span>
            </a>
          </div>

          <!-- Micro Trust Point -->
          <div class="mt-10 pt-6 border-t border-slate-100 flex items-center justify-center lg:justify-start gap-6 text-xs text-slate-500 font-medium">
            <span class="flex items-center gap-1.5"><i class="fa-solid fa-circle-check text-emerald-500"></i> Database Terhubung</span>
            <span class="flex items-center gap-1.5"><i class="fa-solid fa-circle-check text-emerald-500"></i> CRUD Realtime</span>
            <span class="flex items-center gap-1.5"><i class="fa-solid fa-circle-check text-emerald-500"></i> Logger Aktif</span>
          </div>
        </div>

        <!-- Right Column: Mockup Tablet & Floating Widgets (Persis Referensi) -->
        <div class="lg:col-span-6 relative flex justify-center">
          <!-- Tablet Mockup Wrapper -->
          <div class="relative w-full max-w-lg bg-slate-900 p-3 sm:p-4 rounded-[36px] shadow-2xl border-4 border-slate-800">
            <!-- Screen Content -->
            <div class="bg-slate-50 rounded-[24px] overflow-hidden border border-slate-200">
              <!-- Mockup App Header -->
              <div class="bg-white px-4 py-3 border-b border-slate-200 flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <div class="w-6 h-6 rounded-lg bg-buku-600 text-white flex items-center justify-center text-[10px] font-bold">
                    SG
                  </div>
                  <span class="text-xs font-bold text-slate-800"><%= appName %> Pro</span>
                </div>
                <div class="flex items-center gap-2 text-[10px] font-mono text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Live PostgreSQL
                </div>
              </div>

              <!-- Mockup App Body -->
              <div class="p-4 space-y-3">
                <div class="grid grid-cols-2 gap-2 text-xs">
                  <div class="bg-white p-2.5 rounded-xl border border-slate-200/80 shadow-xs">
                    <span class="text-[10px] text-slate-400 block font-bold">TOTAL LAYANAN</span>
                    <span class="text-lg font-black text-slate-900"><%= layanan.length %> Paket</span>
                  </div>
                  <div class="bg-white p-2.5 rounded-xl border border-slate-200/80 shadow-xs">
                    <span class="text-[10px] text-slate-400 block font-bold">STATUS READY</span>
                    <span class="text-lg font-black text-emerald-600"><%= layanan.filter(l => l.tersedia).length %> Aktif</span>
                  </div>
                </div>

                <!-- Mini Mockup Table -->
                <div class="bg-white rounded-xl border border-slate-200/80 overflow-hidden text-[11px]">
                  <div class="bg-slate-100/80 px-3 py-1.5 font-bold text-slate-500 flex justify-between">
                    <span>Layanan Servis</span>
                    <span>Tarif Mulai</span>
                  </div>
                  <div class="divide-y divide-slate-100">
                    <% layanan.slice(0, 3).forEach(function(l) { %>
                      <div class="px-3 py-2 flex items-center justify-between">
                        <div class="flex items-center gap-2">
                          <span class="px-1.5 py-0.5 rounded bg-slate-100 text-[10px] font-mono font-bold text-slate-700"><%= l.id %></span>
                          <span class="font-bold text-slate-800 truncate max-w-[120px]"><%= l.nama %></span>
                        </div>
                        <span class="font-extrabold text-buku-700 font-mono"><%= formatRupiah(l.hargaMulaiDari) %></span>
                      </div>
                    <% }); %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Floating Widget Top-Left: Top Layanan -->
          <div class="hidden sm:flex absolute -top-4 -left-4 bg-white p-3.5 rounded-2xl shadow-card border border-slate-200/80 items-center gap-3 z-20 animate-bounce duration-1000" style="animation-duration: 4s;">
            <div class="w-9 h-9 rounded-xl bg-buku-50 text-buku-600 flex items-center justify-center text-sm font-bold">
              <i class="fa-solid fa-fire"></i>
            </div>
            <div>
              <span class="text-[10px] font-bold text-slate-400 uppercase block">Top Layanan</span>
              <span class="text-xs font-extrabold text-slate-800">Tune-Up Injeksi</span>
            </div>
          </div>

          <!-- Floating Widget Bottom-Right: Unit Servis -->
          <div class="hidden sm:flex absolute -bottom-4 -right-4 bg-white p-3.5 rounded-2xl shadow-card border border-slate-200/80 items-center gap-3 z-20">
            <div class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-sm font-bold">
              <i class="fa-solid fa-motorcycle"></i>
            </div>
            <div>
              <span class="text-[10px] font-bold text-slate-400 uppercase block">Antrean Servis</span>
              <span class="text-xs font-extrabold text-slate-800">Honda Vario 160 &bull; Pit 1</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 2. SECTION FITUR TERBAIK DALAM SATU PLATFORM (PERSIS REFERENSI) ═══ -->
    <section id="fitur-utama" class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-slate-100">
      <div class="grid lg:grid-cols-12 gap-12 items-center">

        <!-- Left Column: Blue Service Timeline Card -->
        <div class="lg:col-span-5 relative">
          <div class="bg-gradient-to-br from-buku-600 to-buku-800 rounded-3xl p-6 sm:p-8 text-white shadow-buku relative overflow-hidden">
            <!-- Background pattern curves -->
            <div class="absolute -right-12 -bottom-12 w-48 h-48 bg-white/10 rounded-full blur-xl pointer-events-none"></div>

            <div class="flex items-center justify-between pb-4 border-b border-white/20 mb-6">
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-buku-100">Riwayat Servis</span>
              <span class="text-xs px-2.5 py-0.5 rounded-full bg-white/20 text-white font-bold">Aktif</span>
            </div>

            <div class="space-y-4">
              <div class="bg-white/10 backdrop-blur-sm p-4 rounded-2xl border border-white/15">
                <div class="flex items-center justify-between text-xs text-buku-100 font-semibold mb-1">
                  <span>Hari Ini &bull; 09:30 WIB</span>
                  <span class="text-amber-300 font-bold">Pit 1</span>
                </div>
                <h4 class="text-base font-extrabold text-white">Servis Rutin + Ganti Oli</h4>
                <p class="text-xs text-white/80 mt-1">Honda Vario 150 &bull; B 4018 GHT</p>
              </div>

              <div class="bg-white/10 backdrop-blur-sm p-4 rounded-2xl border border-white/15">
                <div class="flex items-center justify-between text-xs text-buku-100 font-semibold mb-1">
                  <span>Hari Ini &bull; 11:00 WIB</span>
                  <span class="text-emerald-300 font-bold">Pit 2</span>
                </div>
                <h4 class="text-base font-extrabold text-white">Tune-Up Injeksi Komplit</h4>
                <p class="text-xs text-white/80 mt-1">Yamaha NMAX 155 &bull; B 2021 PAW</p>
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-white/20 flex items-center justify-between text-xs text-buku-100">
              <span>Status PostgreSQL Pool:</span>
              <span class="font-bold text-white font-mono">10 Connections Ready</span>
            </div>
          </div>
        </div>

        <!-- Right Column: Numbered Accordion List (01 - 05) -->
        <div class="lg:col-span-7">
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-buku-600 bg-buku-50 px-3 py-1 rounded-full border border-buku-100">
            Sistem Terintegrasi
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 mt-3 mb-6">
            Fitur-Fitur Terbaik dalam Satu Platform
          </h2>

          <div class="divide-y divide-slate-100">
            <!-- 01 -->
            <div class="py-4 group">
              <div class="flex items-start gap-4">
                <span class="font-mono text-base font-black text-buku-600 w-8">01</span>
                <div>
                  <h3 class="text-base font-bold text-slate-900 group-hover:text-buku-600 transition">
                    Database PostgreSQL Terintegrasi Penuh
                  </h3>
                  <p class="text-xs text-slate-500 mt-1.5 leading-relaxed">
                    Seluruh data layanan tersimpan secara permanen pada tabel database PostgreSQL dengan modul pool koneksi terpisah di <code class="font-mono text-buku-700 bg-buku-50 px-1 py-0.5 rounded">config/database.js</code>.
                  </p>
                </div>
              </div>
            </div>

            <!-- 02 -->
            <div class="py-4 group">
              <div class="flex items-start gap-4">
                <span class="font-mono text-base font-black text-buku-600 w-8">02</span>
                <div>
                  <h3 class="text-base font-bold text-slate-900 group-hover:text-buku-600 transition">
                    Implementasi RESTful CRUD Lengkap
                  </h3>
                  <p class="text-xs text-slate-500 mt-1.5 leading-relaxed">
                    Menyediakan operasi Create, Read, Update, dan Delete via HTTP Method GET, POST, PUT, DELETE yang menghasilkan response JSON konsisten dengan status code standar.
                  </p>
                </div>
              </div>
            </div>

            <!-- 03 -->
            <div class="py-4 group">
              <div class="flex items-start gap-4">
                <span class="font-mono text-base font-black text-buku-600 w-8">03</span>
                <div>
                  <h3 class="text-base font-bold text-slate-900 group-hover:text-buku-600 transition">
                    Manajemen Katalog Jasa &amp; Tarif Terbuka
                  </h3>
                  <p class="text-xs text-slate-500 mt-1.5 leading-relaxed">
                    Kemudahan mengatur paket perbaikan, harga dasar mulai dari, dan estimasi menit pengerjaan secara transparan tanpa data statis.
                  </p>
                </div>
              </div>
            </div>

            <!-- 04 -->
            <div class="py-4 group">
              <div class="flex items-start gap-4">
                <span class="font-mono text-base font-black text-buku-600 w-8">04</span>
                <div>
                  <h3 class="text-base font-bold text-slate-900 group-hover:text-buku-600 transition">
                    Middleware HTTP Audit Logger Otomatis
                  </h3>
                  <p class="text-xs text-slate-500 mt-1.5 leading-relaxed">
                    Mencatat setiap request yang masuk ke backend (HTTP Method, URL path, response status, latency, dan timestamp) ke console dan file <code class="font-mono text-slate-700 bg-slate-100 px-1 py-0.5 rounded">access.log</code>.
                  </p>
                </div>
              </div>
            </div>

            <!-- 05 -->
            <div class="py-4 group">
              <div class="flex items-start gap-4">
                <span class="font-mono text-base font-black text-buku-600 w-8">05</span>
                <div>
                  <h3 class="text-base font-bold text-slate-900 group-hover:text-buku-600 transition">
                    Pemisahan Arsitektur Model-View-Controller (MVC)
                  </h3>
                  <p class="text-xs text-slate-500 mt-1.5 leading-relaxed">
                    Pemisahan tanggung jawab yang rapi: Model mengelola query SQL, Controller mengatur alur bisnis, dan View EJS menyajikan antarmuka dinamis.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 3. SECTION "LEBIH DARI SEKADAR FITUR UTAMA" (6 GRID CARDS PERSIS REFERENSI) ═══ -->
    <section id="keunggulan" class="py-16 sm:py-24 bg-slate-50/70 border-t border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-buku-600 bg-buku-50 px-3 py-1 rounded-full border border-buku-100">
            Ekosistem Lengkap
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 mt-3">
            Lebih dari Sekadar Fitur Utama
          </h2>
          <p class="text-slate-500 text-xs sm:text-sm mt-2 leading-relaxed">
            Jelajahi berbagai fitur lengkap <%= appName %> yang akan membantu Anda mengelola operasional bengkel dengan lebih efisien dan profesional.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Card 1 -->
          <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-card hover:shadow-card-hover transition group">
            <div class="w-12 h-12 rounded-xl bg-buku-50 text-buku-600 flex items-center justify-center text-xl mb-4 group-hover:bg-buku-600 group-hover:text-white transition">
              <i class="fa-solid fa-print"></i>
            </div>
            <h3 class="font-bold text-slate-900 text-sm mb-1.5">Format Standar Cetak &amp; Struk</h3>
            <p class="text-slate-500 text-xs leading-relaxed">
              Format data servis dan biaya terstruktur rapi memudahkan pembuatan laporan transaksi maupun struk estimasi pelanggan.
            </p>
          </div>

          <!-- Card 2 -->
          <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-card hover:shadow-card-hover transition group">
            <div class="w-12 h-12 rounded-xl bg-buku-50 text-buku-600 flex items-center justify-center text-xl mb-4 group-hover:bg-buku-600 group-hover:text-white transition">
              <i class="fa-solid fa-wand-magic-sparkles"></i>
            </div>
            <h3 class="font-bold text-slate-900 text-sm mb-1.5">Mudah &amp; Praktis Digunakan</h3>
            <p class="text-slate-500 text-xs leading-relaxed">
              Antarmuka responsif dan bersih memudahkan admin maupun mekanik mengelola data servis tanpa kurva belajar yang rumit.
            </p>
          </div>

          <!-- Card 3 -->
          <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-card hover:shadow-card-hover transition group">
            <div class="w-12 h-12 rounded-xl bg-buku-50 text-buku-600 flex items-center justify-center text-xl mb-4 group-hover:bg-buku-600 group-hover:text-white transition">
              <i class="fa-solid fa-bolt"></i>
            </div>
            <h3 class="font-bold text-slate-900 text-sm mb-1.5">PostgreSQL Pool Berkualitas</h3>
            <p class="text-slate-500 text-xs leading-relaxed">
              Koneksi terkelola dengan <code class="font-mono text-buku-700">pg.Pool</code> yang efisien menangani banyak query simultan tanpa membebani server.
            </p>
          </div>

          <!-- Card 4 -->
          <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-card hover:shadow-card-hover transition group">
            <div class="w-12 h-12 rounded-xl bg-buku-50 text-buku-600 flex items-center justify-center text-xl mb-4 group-hover:bg-buku-600 group-hover:text-white transition">
              <i class="fa-solid fa-lock"></i>
            </div>
            <h3 class="font-bold text-slate-900 text-sm mb-1.5">Keamanan Kredensial (.env)</h3>
            <p class="text-slate-500 text-xs leading-relaxed">
              Password dan kredensial database disimpan secara aman pada environment file dan diabaikan dari git publik repository.
            </p>
          </div>

          <!-- Card 5 -->
          <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-card hover:shadow-card-hover transition group">
            <div class="w-12 h-12 rounded-xl bg-buku-50 text-buku-600 flex items-center justify-center text-xl mb-4 group-hover:bg-buku-600 group-hover:text-white transition">
              <i class="fa-solid fa-code"></i>
            </div>
            <h3 class="font-bold text-slate-900 text-sm mb-1.5">Pengujian API &amp; Web Lengkap</h3>
            <p class="text-slate-500 text-xs leading-relaxed">
              Dukungan pengujian menyeluruh pada dua sisi: melalui antarmuka web interaktif maupun pengujian REST API via curl atau Postman.
            </p>
          </div>

          <!-- Card 6 -->
          <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-card hover:shadow-card-hover transition group">
            <div class="w-12 h-12 rounded-xl bg-buku-50 text-buku-600 flex items-center justify-center text-xl mb-4 group-hover:bg-buku-600 group-hover:text-white transition">
              <i class="fa-solid fa-clipboard-list"></i>
            </div>
            <h3 class="font-bold text-slate-900 text-sm mb-1.5">Riwayat Log Akses Terperinci</h3>
            <p class="text-slate-500 text-xs leading-relaxed">
              Setiap request dicatat ke terminal dan file Markdown tabel sehingga aktivitas server terpantau transparan setiap saat.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 4. KATALOG LAYANAN (LIVE DATA DARI POSTGRESQL) ═══ -->
    <section id="katalog" class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-slate-200">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
        <div>
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-buku-600 bg-buku-50 px-2.5 py-0.5 rounded-full border border-buku-100">
            Katalog Servis
          </span>
          <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 mt-2">Daftar Paket Layanan</h2>
          <p class="text-slate-500 text-xs sm:text-sm mt-1">
            Data dimuat secara dinamis dari database PostgreSQL melalui <code class="font-mono text-buku-700 bg-buku-50 px-1 py-0.5 rounded font-bold">models/layananModel.js</code>
          </p>
        </div>
        <a href="/layanan"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-buku-600 hover:bg-buku-700 text-white text-xs font-bold shadow-buku-sm transition">
          <span>Kelola Semua di Dasbor CRUD</span>
          <i class="fa-solid fa-arrow-right text-[10px]"></i>
        </a>
      </div>

      <!-- Grid of Services -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% layanan.slice(0, 6).forEach(function(l) { %>
          <div class="p-6 rounded-2xl border border-slate-200 bg-white hover:shadow-card-hover hover:-translate-y-1 transition-all duration-200 flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between mb-3.5">
                <span class="font-mono text-[11px] font-bold text-slate-700 px-2.5 py-0.5 rounded-lg bg-slate-100 border border-slate-200 shadow-xs">
                  <%= l.id %>
                </span>
                <span class="inline-flex items-center gap-1.5 text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-buku-50 text-buku-700 border border-buku-100">
                  <span class="w-1.5 h-1.5 rounded-full bg-buku-600"></span>
                  <span><%= l.kategori %></span>
                </span>
              </div>
              <h3 class="font-extrabold text-slate-900 text-base group-hover:text-buku-600 transition-colors">
