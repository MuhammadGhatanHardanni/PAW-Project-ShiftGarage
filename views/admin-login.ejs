<%- include('partials/head', { judul }) %>

  <body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col justify-between font-sans selection:bg-gold-400 selection:text-navy-950">

    <!-- Top Minimal Header -->
    <header class="w-full py-6 px-4 sm:px-8 flex items-center justify-between max-w-5xl mx-auto">
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="w-9 h-9 rounded-xl bg-gold-400 text-navy-950 flex items-center justify-center font-black text-sm shadow-sm group-hover:scale-105 transition">
          <i class="fa-solid fa-motorcycle"></i>
        </div>
        <span class="text-lg font-black tracking-tight text-navy-900">
          ShiftGarage<span class="text-gold-500">.com</span>
        </span>
      </a>

      <a href="/" class="text-xs font-bold text-slate-500 hover:text-navy-900 flex items-center gap-1.5 transition">
        <i class="fa-solid fa-arrow-left text-[10px]"></i>
        <span>Ke Beranda</span>
      </a>
    </header>

    <!-- Main Login Card (Clean & Minimalist) -->
    <main class="flex-1 flex items-center justify-center p-4">
      <div class="w-full max-w-sm">

        <!-- Card Container -->
        <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200/80 shadow-sm space-y-5">
          
          <!-- Card Header -->
          <div class="text-center space-y-1">
            <h1 class="text-xl font-black text-navy-900 tracking-tight">
              Portal Staf Bengkel
            </h1>
            <p class="text-xs text-slate-500">
              Masuk untuk mengelola operasional Shift Garage.
            </p>
          </div>

          <!-- Alert Pesan (Error / Peringatan / Sukses) -->
          <% if (typeof notif !== 'undefined' && notif) { %>
            <div class="p-3 rounded-xl flex items-center gap-2.5 <%= tipeNotif === 'error' ? 'bg-rose-50 border border-rose-200 text-rose-700' : (tipeNotif === 'warning' ? 'bg-amber-50 border border-amber-200 text-amber-700' : 'bg-emerald-50 border border-emerald-200 text-emerald-700') %> text-xs font-semibold">
              <i class="fa-solid <%= tipeNotif === 'error' ? 'fa-circle-xmark text-rose-500' : (tipeNotif === 'warning' ? 'fa-triangle-exclamation text-amber-500' : 'fa-circle-check text-emerald-500') %> text-sm shrink-0"></i>
              <span><%= notif %></span>
            </div>
          <% } %>

          <!-- Form Login -->
          <form id="loginForm" action="/admin/login" method="POST" class="space-y-4">

            <!-- Username Field -->
            <div>
              <label for="username" class="block text-xs font-bold text-slate-700 mb-1">
                Username
              </label>
              <div class="relative">
                <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400 pointer-events-none text-xs">
                  <i class="fa-regular fa-user"></i>
                </span>
                <input
                  type="text"
                  id="username"
                  name="username"
                  value="admin"
                  required
                  placeholder="admin"
                  class="w-full pl-9 pr-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold text-slate-800 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-navy-900 transition"
                >
              </div>
            </div>

            <!-- Password Field -->
            <div>
              <label for="password" class="block text-xs font-bold text-slate-700 mb-1">
                Kata Sandi
              </label>
              <div class="relative">
                <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400 pointer-events-none text-xs">
                  <i class="fa-solid fa-lock"></i>
                </span>
                <input
                  type="password"
                  id="password"
                  name="password"
                  value="bengkel123"
                  required
                  placeholder="••••••••"
                  class="w-full pl-9 pr-9 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold text-slate-800 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-navy-900 transition"
                >
                <button
                  type="button"
                  id="toggleEyeBtn"
                  onclick="togglePassword()"
                  aria-label="Tampilkan atau sembunyikan kata sandi"
                  class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600 text-xs transition"
                >
                  <i id="eyeIcon" class="fa-regular fa-eye"></i>
                </button>
              </div>
            </div>

            <!-- Simple Demo Note -->
            <div class="p-2.5 rounded-lg bg-slate-100/80 text-[11px] text-slate-500 flex items-center justify-between">
              <span>Akun Demo: <strong>admin</strong></span>
              <span>Sandi: <strong>bengkel123</strong></span>
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              id="submitBtn"
              class="w-full py-3 rounded-xl bg-gold-400 hover:bg-gold-300 text-navy-950 font-black text-xs shadow-sm transition hover:scale-[1.01] active:scale-[0.99] flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>Masuk ke Dasbor</span>
              <i class="fa-solid fa-arrow-right text-[10px]"></i>
            </button>

          </form>

        </div>

      </div>
    </main>

    <!-- Bottom Minimal Footer -->
    <footer class="py-6 text-center text-[11px] text-slate-400">
      &copy; <%= new Date().getFullYear() %> Shift Garage &bull; Muhammad Ghatan Hardanni (20240140182)
    </footer>

    <!-- Script Show/Hide Password -->
    <script>
      function togglePassword() {
        const pass = document.getElementById('password');
        const icon = document.getElementById('eyeIcon');
        if (!pass || !icon) return;

        if (pass.type === 'password') {
          pass.type = 'text';
          icon.classList.remove('fa-eye');
          icon.classList.add('fa-eye-slash');
        } else {
          pass.type = 'password';
          icon.classList.remove('fa-eye-slash');
          icon.classList.add('fa-eye');
        }
      }
    </script>

  </body>
</html>